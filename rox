    agents_parser = commands.add_parser("update-agents",
                                        help="update a running guest's agent CLIs and refresh their credentials")
    agents_parser.add_argument("name", nargs="?", help="guest to update; omit with --all")
    agents_parser.add_argument("--all", action="store_true", help="update every running guest on this machine")
    agents_parser.add_argument("--config", help="config file on the machine that runs the guest")
    open_parser = commands.add_parser("open", help="show a guest's own Rex session in the Rex app, so splits run in the guest")
