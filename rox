def toolkit_version():
    match = re.search(r'^LABEL io\.rox\.toolkit="([^"]+)"', (HERE / "Containerfile").read_text(), re.MULTILINE)
    return match[1] if match else ""


def prepare_container_image(engine, image):
    if image != DEFAULT_CONTAINER_IMAGE:
        return

    # Recheck after taking the lock in case another launch built the image.
    with (state_root() / "container-image.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        info = image_info(engine, image)
        wanted = toolkit_version()
        if info and info[1].get("io.rox.toolkit") == wanted:
            return
        reason = "first build" if not info else "the Containerfile or container entrypoint changed"
        print(f"Building {image} with {engine} ({reason})", flush=True)
        try:
            run([engine, "build", "--file", str(HERE / "Containerfile"), "--tag", image, str(HERE)])
        except subprocess.CalledProcessError as error:
            raise Error(f"Building {image} with {engine} failed. See the build output above.") from error


