fi
printf '%s' "$kc" | base64 -D | sudo -n tee /etc/kcpassword >/dev/null
sudo -n chown root:wheel /etc/kcpassword
sudo -n chmod 600 /etc/kcpassword
sudo -n defaults write /Library/Preferences/com.apple.loginwindow autoLoginUser "$user"
"""

# Unpack the Rex app from stdin and put its CLI on SSH's PATH. SSH runs commands through zsh, which reads
# ~/.zshenv even when it isn't a login shell.
TEMPLATE_REX_SCRIPT = r"""set -eu
archive=$(mktemp /tmp/rex.XXXXXX)
trap 'rm -f "$archive"' EXIT
cat > "$archive"
sudo -n rm -rf /Applications/Rex.app
sudo -n ditto -x -k "$archive" /Applications
mkdir -p "$HOME/.local/bin"
ln -sfn "/Applications/Rex.app/$1" "$HOME/.local/bin/rex"
line='export PATH="$HOME/.local/bin:$PATH"'
touch "$HOME/.zshenv"
grep -qxF "$line" "$HOME/.zshenv" || printf '%s\n' "$line" >> "$HOME/.zshenv"
"""

TEMPLATE_CHECK_SCRIPT = r"""set -eu
if ! command -v rex >/dev/null; then
  echo "rex isn't on SSH's PATH in the template." >&2
  exit 1
fi
rex version | head -n 1
if ! git --version; then
  echo "Git doesn't run in the template. Install the Xcode Command Line Tools there." >&2
  exit 1
fi
bash --version | head -n 1
"""


class TemplateGuest(Guest):
    """A Tart template that rox template boots to prepare."""

    @property
    def directory(self):
        return state_root() / "templates" / self.name


def kcpassword(password):
    data = password.encode()
    data += b"\0" * (12 - len(data) % 12)
    return bytes(byte ^ KCPASSWORD_KEY[index % len(KCPASSWORD_KEY)] for index, byte in enumerate(data))


def template_password(path):
    """The template's login password, saved on first use where only this user can read it."""
    if path.exists():
        return path.read_text().strip()
    password = secrets.token_urlsafe(18)
    write_private(path, password + "\n")
    return password


def boot_template(guest, boot_timeout):
    """Boot the template and wait until it takes SSH logins. Return the Tart process."""
    vm = run_vm(guest)

    def address():
        if vm.poll() is not None:
            raise Error(f"Tart exited with status {vm.returncode}. See {guest.directory / 'tart.log'}")
        return vm_address(guest)

    guest.address, guest.port = wait_for(address, boot_timeout, f"{guest.name} to get an address")
    check_guest_os(guest, boot_timeout)
    return vm


def shut_down_template(guest, vm):
    run(remote_command(guest, ["sync"]), capture=True, check=False, timeout=60)
    run(remote_command(guest, ["sudo", "-n", "shutdown", "-h", "now"]), capture=True, check=False, timeout=60)
    try:
        vm.wait(timeout=180)
    except subprocess.TimeoutExpired:
        run(["tart", "stop", guest.name], capture=True, check=False, timeout=120)
        vm.wait(timeout=60)


def authorize_template_key(guest, public_key, host_key, boot_timeout):
    """Make sure SSH takes the login key, and return the template's host key.

    A fresh base image only lets the key in through Tart's guest agent. The agent runs in the desktop
    session, so a template whose auto-login broke never answers it. One that rox already prepared takes
    SSH with its pinned host key instead.
    """
    pinned = host_key.read_text() if host_key.is_file() else ""

    def ready():
        if pinned:
            pin_host(guest, pinned)
            try:
                guest.address, guest.port = vm_address(guest)
                if run(remote_command(guest, ["true"]), capture=True, check=False, timeout=10).returncode == 0:
                    return "ssh"
            except (Error, subprocess.TimeoutExpired):
                pass
        return "agent" if run(["tart", "exec", guest.name, "true"], capture=True, check=False,
                              timeout=15).returncode == 0 else None

    if wait_for(ready, boot_timeout, f"SSH or the Tart guest agent in {guest.name}") == "ssh":
        run(remote_command(guest, ["bash", "-c", AUTHORIZE_SCRIPT, "rox", public_key]), capture=True)
        return output(remote_command(guest, ["cat", "/etc/ssh/ssh_host_ed25519_key.pub"]), timeout=30)
    output(["tart", "exec", guest.name, "/bin/bash", "-c", AUTHORIZE_SCRIPT, "rox", public_key], timeout=30)
    return output(["tart", "exec", guest.name, "cat", "/etc/ssh/ssh_host_ed25519_key.pub"], timeout=30)


def install_template_rex(guest):
    with tempfile.TemporaryDirectory() as scratch:
        archive = Path(scratch) / "Rex.zip"
        run(["ditto", "-c", "-k", "--keepParent", str(REX_APP), str(archive)])
        with archive.open("rb") as stream:
            if subprocess.run(remote_command(guest, ["bash", "-c", TEMPLATE_REX_SCRIPT, "rox", REX_APP_CLI]),
                              stdin=stream).returncode:
                raise Error(f"Could not install Rex in {guest.name}")


def prepare_template(args):
    """Clone, set up and check a macOS Tart template, then point the macos config at it."""
    if sys.platform != "darwin" or platform.machine() != "arm64":
        raise Error("Tart templates need an Apple Silicon Mac")
    require(["tart", "ssh", "ssh-keygen", "ditto"])
    if not (REX_APP / REX_APP_CLI).is_file():
        raise Error(f"Install the Rex app at {REX_APP} first. rox template copies it into the template")
    config_path, config = load_config(args)
    settings = config.get("macos", {})
    if not isinstance(settings, dict):
        raise Error(f"Expected an object for macos in {config_path}")
    name = args.name or settings.get("image") or DEFAULT_TEMPLATE_NAME
    user = settings.get("user", "admin")
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", name) or re.fullmatch(NAME_PATTERN, name):
        raise Error(f"Choose a template name other than {name!r}")
    if not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_.-]*", user):
        raise Error(f"Expected a user name for macos.user in {config_path}")
    identity_setting = settings.get("identity") or "~/.ssh/rox_vm"
    host_key_setting = settings.get("host_key") or f"~/.ssh/{name.replace('-', '_')}_host.pub"
    identity = Path(identity_setting).expanduser().resolve()
    host_key = Path(host_key_setting).expanduser().resolve()
    password_path = config_path.with_name(f"{name}-{user}-password")

    if name in tart_images():
        guest_probe = TemplateGuest(name, "macos", name, user)
        if guest_state(guest_probe) == "running":
            raise Error(f"{name} is running. Shut it down and run rox template again")
        print(f"Updating template {name}", flush=True)
    else:
        print(f"Cloning {args.base} into {name}. A first pull downloads about 30 GB.", flush=True)
        run(["tart", "clone", args.base, name])
    if not identity.exists():
        identity.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "rox vm login", "-f", str(identity)],
            stdin=subprocess.DEVNULL)
        print(f"Created VM login key {identity}", flush=True)
    public_key = Path(f"{identity}.pub").read_text().strip()

    guest = TemplateGuest(name, "macos", name, user, identity=str(identity))
    shutil.rmtree(guest.directory, ignore_errors=True)
    guest.directory.mkdir(mode=0o700, parents=True)
    print(f"Booting {name}", flush=True)
    vm = run_vm(guest)
    try:
        key = authorize_template_key(guest, public_key, host_key, args.boot_timeout)
        pin_host(guest, key)
        host_key.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        host_key.write_text(key.strip() + "\n")
        guest.address, guest.port = wait_for(lambda: vm_address(guest), args.boot_timeout,
                                             f"{name} to get an address")
        check_guest_os(guest, args.boot_timeout)

        print("Replacing the base image's password and keeping auto-login working", flush=True)
        password = template_password(password_path)
        secret = "\n".join([args.base_password, password, base64.b64encode(kcpassword(password)).decode()])
        run(remote_command(guest, ["bash", "-c", TEMPLATE_PASSWORD_SCRIPT]), input=secret + "\n")

        print(f"Installing Rex from {REX_APP}", flush=True)
        install_template_rex(guest)
        print(output(remote_command(guest, ["bash", "-c", TEMPLATE_CHECK_SCRIPT])), flush=True)
        shut_down_template(guest, vm)

        print(f"Rebooting {name} to check that {user} signs in to the desktop", flush=True)
        vm = boot_template(guest, args.boot_timeout)
        wait_for(lambda: output(remote_command(guest, ["stat", "-f", "%Su", "/dev/console"]), timeout=8) == user,
                 args.boot_timeout, f"{user} to sign in to the desktop of {name}")
        shut_down_template(guest, vm)
    finally:
        if vm.poll() is None:
            run(["tart", "stop", guest.name], capture=True, check=False, timeout=120)

    with locked_config(config_path) as current:
        section = current.setdefault("macos", {})
        section.update(image=name, user=user, identity=identity_setting, host_key=host_key_setting)
        write_config(config_path, current)
    shutil.rmtree(guest.directory, ignore_errors=True)
    print(f"Template  {name}\nPassword  {password_path}\nConfig    {config_path} (macos)\n"
          f"Launch with rox up macos. Run rox template macos again after upgrading Rex.", flush=True)


@dataclass
class Branch:
    """The launched branch as the launch machine read it."""
    mirror: Path
    commit: str
    hook: str
    settings: dict


def read_branch(url, branch, keys, known_hosts):
    """Fetch the branch to find its .rox.sh and .rox.json, or return None if the launcher can't read it."""
    try:
        with host_git(keys, known_hosts) as env:
            mirror, commit, hook = fetch_branch(url, branch, env)
    except (Error, subprocess.SubprocessError) as error:
        print(f"rox: Could not read {branch} on the launch machine, so .rox.sh will run at boot "
              f"and any {PROJECT_CONFIG} is ignored. ({error})", file=sys.stderr, flush=True)
        return None
    return Branch(mirror, commit, hook, project_settings(mirror, commit))


def project_settings(mirror, commit):
    found = run(["git", "-C", str(mirror), "cat-file", "-e", f"{commit}:{PROJECT_CONFIG}"],
                capture=True, check=False)
    if found.returncode:
        return {}
    try:
        settings = json.loads(output(["git", "-C", str(mirror), "show", f"{commit}:{PROJECT_CONFIG}"]))
    except ValueError as error:
        raise Error(f"{PROJECT_CONFIG} on the branch is not valid JSON: {error}") from None
    return checked_project_settings(settings, PROJECT_CONFIG)


def local_project_settings(args):
    """The checkout's .rox.local.json, when rox up launches the checkout it runs in.

    A launch on another host gets them from the machine that ran rox up, as --local-settings.
    """
    if args.local_settings is not None:
        try:
            settings = json.loads(args.local_settings)
        except ValueError as error:
            raise Error(f"--local-settings is not valid JSON: {error}") from None
        return checked_project_settings(settings, LOCAL_CONFIG)
    if args.project is not None or getattr(args, "no_project", False) or not in_checkout(args.cwd):
        return {}
    root = output(["git", "-C", str(args.cwd), "rev-parse", "--show-toplevel"]).strip()
    path = Path(root) / LOCAL_CONFIG
    if not path.is_file():
        return {}
    try:
        settings = json.loads(path.read_text())
    except ValueError as error:
        raise Error(f"{path} is not valid JSON: {error}") from None
    settings = checked_project_settings(settings, LOCAL_CONFIG)
    if settings:
        print(f"Using settings from {path}", flush=True)
    return settings


def checked_project_settings(settings, where):
    """Check .rox.json or .rox.local.json settings, named by where in errors."""
    if not isinstance(settings, dict):
        raise Error(f"Expected a JSON object in {where}")
    for key, value in settings.items():
        if key == "backend":
            if value not in BACKENDS:
                raise Error(f"Expected backend to be one of {', '.join(BACKENDS)} in {where}")
        elif key in PROJECT_KEYS:
            if not isinstance(value, dict):
                raise Error(f"Expected an object for {key} in {where}")
            for setting in value:
                if setting in LAUNCHER_KEYS:
                    raise Error(f"{key}.{setting} can only be set in the rox config on the launch machine, "
                                f"not in {where}")
                if setting not in PROJECT_KEYS[key]:
                    allowed = ", ".join(sorted(PROJECT_KEYS[key]))
                    raise Error(f"Unknown setting {key}.{setting} in {where}. Use {allowed}")
        elif key in LAUNCHER_KEYS:
            raise Error(f"{key} can only be set in the rox config on the launch machine, not in {where}")
        else:
            raise Error(f"Unknown setting {key} in {where}. Use backend, {', '.join(BACKENDS)}")
    return settings


def prepare_project_image(backend, engine, base, project, url, branch, keys, known_hosts, vm, rebuild,
                          fetched):
    """Return a project image that already ran .rox.sh, or "" to set up at boot."""
    if not fetched or not fetched.hook:
        return ""
    mirror, commit, hook = fetched.mirror, fetched.commit, fetched.hook
    target = project_image_name(backend, project, base)
    if engine:
        build_container_image(engine, base, target, mirror, url, branch, hook, rebuild)
    else:
        name = f"rv-build-{secrets.token_hex(6)}"
        build_vm_image(backend, base, target, project, url, branch, hook, commit,
                       {**vm, "name": name, "keys": keys, "known_hosts": known_hosts}, rebuild)
    return target


def launch_guest(guest, boot_timeout):
    if guest.backend == "container":
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", guest.identity],
            stdin=subprocess.DEVNULL)
        public_key = Path(f"{guest.identity}.pub").read_text().strip()
        if guest.engine == "container":
            return launch_apple_container(guest, public_key, boot_timeout)
        local_image = guest.prebuilt or guest.image.startswith("rox:")
        pull_policy = ["--pull=never"] if local_image else []
        guest.container_id = output([
            guest.engine, "run", "-d", *pull_policy, "--name", guest.name, "--hostname", guest.name,
            "--label", f"io.rox.workspace={guest.name}", "--restart", "unless-stopped",
            "--publish", "127.0.0.1::22", "--env", f"ROX_SSH_PUBLIC_KEY={public_key}",
            *container_resources(guest), guest.image,
        ])
        guest.save()
        key = wait_for(
            lambda: output([guest.engine, "exec", guest.container_id, "cat",
                            "/etc/ssh/ssh_host_ed25519_key.pub"], timeout=8),
            boot_timeout, "the container SSH host key",
        )
        pin_host(guest, key)
        return wait_for(lambda: container_address(guest), boot_timeout, "the container SSH port")

    run(["tart", "clone", guest.image, guest.name])
    resources = ([f"--cpu={guest.cpus}"] if guest.cpus else []) + \
        ([f"--memory={memory_megabytes(guest.memory)}"] if guest.memory else [])
    if resources:
        run(["tart", "set", guest.name, *resources])
    vm = run_vm(guest)
    log_path = guest.directory / "tart.log"

    def address():
        if vm.poll() is not None:
            raise Error(f"Tart exited with status {vm.returncode}. See {log_path}")
        try:
            return vm_address(guest)
        except (Error, subprocess.TimeoutExpired):
            return None

    deadline = time.monotonic() + boot_timeout
    while time.monotonic() < deadline:
        if found := address():
            return found
        time.sleep(1)
    raise Error(f"No Tart IP address found for {guest.name}. See {log_path}")


def run_vm(guest):
    """Run the guest's Tart VM in the background, detached from this process."""
    with (guest.directory / "tart.log").open("a") as log:
        return subprocess.Popen(
            ["tart", "run", "--no-graphics", "--no-clipboard", guest.name],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )


def container_resources(guest):
    return [f"--{option}={value}" for option, value in (("cpus", guest.cpus), ("memory", guest.memory)) if value]


def memory_megabytes(size):
    """Convert a size such as 4G or 512M to the megabytes Tart expects."""
    number, unit = int(size[:-1]), size[-1].upper()
    return max(1, number * {"K": 1, "M": 1024, "G": 1024 ** 2, "T": 1024 ** 3}[unit] // 1024)


def launch_apple_container(guest, public_key, boot_timeout):
    # Each Apple container is its own VM, so the workspace user gets passwordless sudo there.
    output(["container", "run", "--detach", "--name", guest.name, *container_resources(guest),
            "--env", f"ROX_SSH_PUBLIC_KEY={public_key}", "--env", "ROX_SUDO=1", guest.image])
    guest.container_id = guest.name
    guest.save()
    key = wait_for(
        lambda: output(["container", "exec", guest.name, "cat", "/etc/ssh/ssh_host_ed25519_key.pub"], timeout=8),
        boot_timeout, "the container SSH host key",
    )
    pin_host(guest, key)
    return wait_for(lambda: apple_container_address(guest), boot_timeout, "the container IP address")


def check_guest_os(guest, timeout):
    system = wait_for(
        lambda: output(remote_command(guest, ["uname", "-s"]), timeout=8),
        timeout, "guest SSH login",
    )
    expected = "Darwin" if guest.backend == "macos" else "Linux"
    if system != expected:
        raise Error(f"{guest.backend} expects {expected}, but the image runs {system}")


# Run by the forwarding SSH session in the guest: point a fixed path at the forwarded agent, then wait.
GIT_AGENT_SCRIPT = 'ln -sfn "$SSH_AUTH_SOCK" "$1" && exec tail -f /dev/null'


def guest_git_socket(base):
    """Where the guest's Rex server and shells find the forwarded Git agent."""
    return str(PurePosixPath(base) / "git-agent.sock")


def pid_alive(path):
    try:
        os.kill(int(path.read_text()), 0)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        return False
    except PermissionError:
        return True
    return True


def kill_pid(path):
    try:
        os.kill(int(path.read_text()), 15)
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        pass
    path.unlink(missing_ok=True)


def detached(argv, guest, pid_path):
    with (guest.directory / "git-agent.log").open("a") as log:
        process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    pid_path.write_text(f"{process.pid}\n")
    return process


def start_git_agent(guest):
    """Keep the guest's Git keys in an agent on the launcher, forwarded into the guest over SSH.

    The private keys never leave the launcher. Programs in the guest can use them while the forward runs.
    """
    if not guest.git_keys or not guest.guest_socket:
        return
    private_directory(guest.runtime.parent)
    private_directory(guest.runtime)
    sock = guest.runtime / "git-agent.sock"
    env = {**os.environ, "SSH_AUTH_SOCK": str(sock)}
    # ssh-add -l exits 1 when the agent has no keys and 2 when there's no agent.
    status = run(["ssh-add", "-l"], env=env, capture=True, check=False).returncode
    if status == 2:
        kill_pid(guest.runtime / "git-agent.pid")
        sock.unlink(missing_ok=True)
        agent = detached(["ssh-agent", "-D", "-a", str(sock)], guest, guest.runtime / "git-agent.pid")

        def agent_ready():
            if agent.poll() is not None:
                raise Error("Could not start the guest's Git SSH agent")
            return sock.is_socket()

        wait_for(agent_ready, 5, "the guest's Git SSH agent")
        status = 1
    if status == 1:
        result = run(["ssh-add", *guest.git_keys], env=env, capture=True, check=False,
                     stdin=None if sys.stdin.isatty() else subprocess.DEVNULL)
        if result.returncode:
            raise Error(f"Could not load the Git keys for {guest.name}: {result.stderr.strip()}. "
                        f"Encrypted keys need their passphrase, so run rox reconnect {guest.name} in a terminal")
    forward = guest.runtime / "git-forward.pid"
    if pid_alive(forward):
        return
    script = shlex.join(["sh", "-c", GIT_AGENT_SCRIPT, "rox", guest_git_socket(guest.base)])
    detached([*ssh_command(guest, "-T", "-S", "none", "-o", f"ForwardAgent={sock}"), script], guest, forward)


def restore_git_agent(guest):
    """Start the guest's Git agent or its forward again if either stopped. Return whether it did."""
    if not guest.git_keys or (pid_alive(guest.runtime / "git-forward.pid")
                              and pid_alive(guest.runtime / "git-agent.pid")):
        return False
    try:
        start_git_agent(guest)
    except (Error, OSError, subprocess.SubprocessError) as error:
        print(f"rox: Git in {guest.name} can't use your SSH keys until this works: {error}",
              file=sys.stderr, flush=True)
        return False
    return True


def close_git_forward(guest):
    kill_pid(guest.runtime / "git-forward.pid")


def stop_git_agent(guest):
    close_git_forward(guest)
    kill_pid(guest.runtime / "git-agent.pid")
    (guest.runtime / "git-agent.sock").unlink(missing_ok=True)


def open_tunnel(guest):
    private_directory(guest.runtime.parent)
    private_directory(guest.runtime)
    if guest.control_socket.is_socket():
        check = run(ssh_command(guest, "-S", str(guest.control_socket), "-O", "check"), capture=True, check=False)
        if check.returncode == 0:
            return
    run(ssh_command(
        guest, "-fNM", "-S", str(guest.control_socket), "-o", "ControlPersist=no",
        "-E", str(guest.directory / "ssh-tunnel.log"),
        "-o", "ForwardAgent=no", "-o", "ExitOnForwardFailure=yes", "-o", "StreamLocalBindUnlink=yes",
        "-L", f"{guest.runtime / 'rex.sock'}:{guest.guest_socket}",
    ), timeout=15)


def rex_on(guest):
    return ["rex", "--autostart=false", "--timeout", "5s", "-S", guest.endpoint]


def open_relay(guest):
    private_directory(guest.runtime.parent)
    private_directory(guest.runtime)
    log_path = guest.directory / "ssh-tunnel.log"
    dial = ["rex", "--autostart=false", "-S", f"unix://{guest.guest_socket}", "__internal", "dial-stdio"]
    # Read the same login PATH as the guest bootstrap, without allocating a terminal.
    command = remote_command(guest, [
        "sh", "-c", 'export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"; exec "$@"',
        "rox", *dial,
    ])
    with log_path.open("a") as log:
        process = subprocess.Popen(
            [sys.executable, str(HERE / "guest" / "relay.py"), str(guest.runtime), *command],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
        )
    try:
        wait_for(lambda: guest.relay_socket.is_socket() and process.poll() is None,
                 5, "the Rex SSH relay")
        output([*rex_on(guest), "ls", "--json"], timeout=8)
    except (Error, subprocess.TimeoutExpired) as error:
        if process.poll() is None:
            close_relay(guest)
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
        raise Error(f"Could not reach Rex through the SSH relay. See {log_path}.\n{error}") from error


def attach_guest(guest, session_id=""):
    try:
        if not guest.relay_socket.is_socket():
            open_tunnel(guest)
        output([*rex_on(guest), "ls", "--json"], timeout=8)
    except (Error, subprocess.SubprocessError):
        guest_stage(guest, "server", guest.guest_socket)
        close_tunnel(guest)
        open_relay(guest)
    if session_id:
        output([*rex_on(guest), "session", "inspect", session_id, "--json"], timeout=8)


def connect(guest, tailnet=None):
    """Find the running guest's SSH address, make sure its Rex server runs, and attach to it."""
    guest.address, guest.port = container_address(guest) if guest.engine else vm_address(guest)
    guest.save()
    guest_stage(guest, "server", guest.guest_socket)
    attach_guest(guest)
    if guest.tailnet_name:
        resume_tailnet(guest, tailnet)


def tailscale_settings(config, config_path, disabled):
    """Return the launcher's tailnet settings for guests, or None to keep guests off the tailnet."""
    settings = config.get("tailscale")
    if settings is None or disabled:
        return None
    if not isinstance(settings, dict):
        raise Error(f"Expected an object for tailscale in {config_path}")
    unknown = set(settings) - {"auth_key_file", "tags", "control_url"}
    if unknown:
        raise Error(f"Unknown tailscale setting {sorted(unknown)[0]} in {config_path}. "
                    "Use auth_key_file, tags and control_url")
    key = configured_file(settings.get("auth_key_file"))
    if not key:
        raise Error(f"Set tailscale.auth_key_file in {config_path} to a file holding a Tailscale auth key")
    if key.stat().st_mode & 0o077:
        raise Error(f"{key} holds a Tailscale auth key, so only you may read it. Run chmod 600 {key}")
    tags = settings.get("tags", [])
    if not isinstance(tags, list) or any(not isinstance(tag, str) or not re.fullmatch(r"tag:[a-z0-9-]+", tag)
                                         for tag in tags):
        raise Error(f"Expected a list of tags such as [\"tag:rox-guest\"] for tailscale.tags in {config_path}")
    control_url = settings.get("control_url", "")
    if not isinstance(control_url, str) or (control_url and not control_url.startswith("https://")):
        raise Error(f"Expected an https:// URL for tailscale.control_url in {config_path}")
    return {"key": key, "tags": tags, "control_url": control_url}


# The agent CLIs rox can install in guests. Each credential setting names a file on the launcher.
# A variable name means the file holds that variable's value for the guest. None means rox handles it
# another way: codex's auth_file is copied to ~/.codex/auth.json, and its api_key_file goes to codex login.
AGENT_CREDENTIALS = {
    "claude": {"token_file": "CLAUDE_CODE_OAUTH_TOKEN", "api_key_file": "ANTHROPIC_API_KEY"},
    "codex": {"auth_file": None, "api_key_file": None},
}
AGENT_NAMES = {"claude": "Claude Code", "codex": "Codex"}
# Where rox config agents saves each kind of credential, next to the config.
AGENT_SECRET_FILES = {("claude", "token_file"): "claude-token", ("claude", "api_key_file"): "anthropic-api-key",
                      ("codex", "api_key_file"): "openai-api-key"}
AGENT_LATEST = {
    "claude": "https://downloads.claude.ai/claude-code-releases/latest",
    "codex": "https://registry.npmjs.org/@openai/codex/latest",
}
AGENT_VERSION_TTL = 6 * 3600
VERSION_PATTERN = r"[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?"
# Written over SSH with the secrets on stdin, so they never appear in argv.
AGENT_ENV_SCRIPT = ('umask 077; mkdir -p "$HOME/.rox" && cat > "$HOME/.rox/agents.env.tmp" '
                    '&& mv "$HOME/.rox/agents.env.tmp" "$HOME/.rox/agents.env"')
CODEX_AUTH_SCRIPT = ('umask 077; mkdir -p "$HOME/.codex" && cat > "$HOME/.codex/auth.json.tmp" '
                     '&& mv "$HOME/.codex/auth.json.tmp" "$HOME/.codex/auth.json"')
CODEX_LOGIN_SCRIPT = 'export PATH="$HOME/.local/bin:$PATH"; codex login --with-api-key >/dev/null'
# What rox copies from the launcher's agent setup unless the config says otherwise.
SYNC_DEFAULTS = {"skills": True, "instructions": True, "mcp": False, "settings": False}
# Settings that name programs or paths on the launcher, or hold its secrets, so guests don't get them.
CLAUDE_HOST_SETTINGS = {"hooks", "statusLine", "apiKeyHelper", "awsAuthRefresh", "awsCredentialExport",
                        "otelHeadersHelper", "env", "enabledPlugins", "extraKnownMarketplaces"}
CODEX_HOST_SETTINGS = {"notify", "projects", "mcp_servers", "hooks", "plugins", "marketplaces", "desktop"}
# Rox isn't installed in guests, so its own skill would only mislead an agent there.
UNSYNCED_SKILLS = {"rox"}
SKILL_NAME_PATTERN = r"[A-Za-z0-9_][A-Za-z0-9_.-]*"
SYNC_RECORD = ".rox/synced.json"
# Prints each file that exists as its path and its contents in base64, one per line.
SYNC_READ_SCRIPT = ('cd "$HOME" || exit; for file; do if [ -f "$file" ]; then '
                    'printf "%s " "$file"; base64 < "$file" | tr -d "\\n"; echo; fi; done')
SYNC_WRITE_SCRIPT = 'cd "$HOME" && if [ "$#" -gt 0 ]; then rm -rf -- "$@"; fi && tar -xf -'


def agent_settings(config, config_path):
    """The agents to install in new guests, as {agent: {"version", credential paths}}. All, unless turned off."""
    settings = config.get("agents")
    if settings is None:
        settings = {}
    if not isinstance(settings, dict):
        raise Error(f"Expected an object for agents in {config_path}")
    for agent in settings:
        if agent not in AGENT_CREDENTIALS:
            raise Error(f"Unknown agent {agent} in {config_path}. Use {' or '.join(AGENT_CREDENTIALS)}")
    agents = {}
    # Agents the config doesn't mention are installed without credentials. false turns one off.
    for agent in AGENT_CREDENTIALS:
        value = settings.get(agent, {})
        if value is False:
            continue
        if not isinstance(value, dict):
            raise Error(f"Expected an object for agents.{agent} in {config_path}")
        allowed = ["version", "sync", *AGENT_CREDENTIALS[agent]]
        if unknown := sorted(set(value) - set(allowed)):
            raise Error(f"Unknown setting agents.{agent}.{unknown[0]} in {config_path}. Use {', '.join(allowed)}")
        version = value.get("version", "latest")
        if not isinstance(version, str) or not (version == "latest" or re.fullmatch(VERSION_PATTERN, version)):
            raise Error(f"Expected latest or a version such as 1.2.3 for agents.{agent}.version in {config_path}")
        credentials = {}
        for setting in AGENT_CREDENTIALS[agent]:
            if setting not in value:
                continue
            if not isinstance(value[setting], str) or not value[setting]:
                raise Error(f"Expected a file path for agents.{agent}.{setting} in {config_path}")
            path = configured_file(value[setting])
            if path.stat().st_mode & 0o077:
                raise Error(f"{path} holds a credential for {AGENT_NAMES[agent]}, so only you may read it. "
                            f"Run chmod 600 {path}")
            credentials[setting] = path
        if len(credentials) > 1:
            raise Error(f"Choose one of {' or '.join(credentials)} for agents.{agent} in {config_path}")
        agents[agent] = {"version": version, "sync": sync_settings(agent, value.get("sync"), config_path),
                         **credentials}
    return agents


def sync_settings(agent, value, config_path):
    """What of the launcher's own agent setup to copy into guests. Skills and instructions by default."""
    sync = dict(SYNC_DEFAULTS)
    if value is None:
        return sync
    if not isinstance(value, dict):
        raise Error(f"Expected an object for agents.{agent}.sync in {config_path}")
    if unknown := sorted(set(value) - set(SYNC_DEFAULTS)):
        raise Error(f"Unknown setting agents.{agent}.sync.{unknown[0]} in {config_path}. "
                    f"Use {', '.join(SYNC_DEFAULTS)}")
    for key in ("skills", "instructions", "settings"):
        if key in value:
            if not isinstance(value[key], bool):
                raise Error(f"Expected true or false for agents.{agent}.sync.{key} in {config_path}")
            sync[key] = value[key]
    if "mcp" in value:
        mcp = value["mcp"]
        if not (isinstance(mcp, bool) or isinstance(mcp, list) and all(isinstance(name, str) and name
                                                                       for name in mcp)):
            raise Error(f"Expected true, false or a list of server names for agents.{agent}.sync.mcp "
                        f"in {config_path}")
        sync["mcp"] = mcp
    return sync


def latest_agent_version(agent):
    request = urllib.request.Request(AGENT_LATEST[agent], headers={"User-Agent": "rox"})
    with urllib.request.urlopen(request, timeout=5) as response:
        body = response.read(1 << 20).decode()
    version = (json.loads(body).get("version") or "") if agent == "codex" else body.strip()
    if not isinstance(version, str) or not re.fullmatch(VERSION_PATTERN, version):
        raise ValueError(f"unexpected version {version[:40]!r}")
    return version


def agent_versions(agents, refresh=False, now=None):
    """The version of each agent to install: its pin, or the latest release, checked every few hours.

    A failed check never stops a launch. Rox uses the last version it found, or the installer's latest.
    """
    now = time.time() if now is None else now
    path = state_root() / "agent-versions.json"
    try:
        cache = json.loads(path.read_text())
    except (FileNotFoundError, ValueError):
        cache = {}
    cache = {agent: entry for agent, entry in cache.items() if isinstance(entry, dict)} if isinstance(cache, dict) else {}
    versions, changed = {}, False
    for agent, settings in agents.items():
        if settings["version"] != "latest":
            versions[agent] = settings["version"]
            continue
        cached = cache.get(agent, {})
        known = cached.get("version") if isinstance(cached.get("version"), str) else ""
        checked = cached.get("checked") if isinstance(cached.get("checked"), (int, float)) else 0
        if known and not refresh and now - checked < AGENT_VERSION_TTL:
            versions[agent] = known
            continue
        try:
            versions[agent] = latest_agent_version(agent)
        except (OSError, ValueError) as error:
            versions[agent] = known or "latest"
            print(f"rox: Could not check for a newer {AGENT_NAMES[agent]} ({error}). "
                  f"Installing {versions[agent]}.", file=sys.stderr, flush=True)
            continue
        cache[agent] = {"version": versions[agent], "checked": now}
        changed = True
    if changed:
        write_private(path, json.dumps(cache, indent=2) + "\n")
    return versions


def agent_specs(versions):
    return [f"{agent}={versions[agent]}" for agent in sorted(versions)]


def describe_agents(versions):
    return ", ".join(f"{AGENT_NAMES[agent]} {versions[agent]}" for agent in sorted(versions))


AGENT_CONTAINERFILE = """\
FROM {base}
USER root
COPY bootstrap.sh /usr/local/share/rox/bootstrap.sh
USER workspace
RUN {install}
USER root
"""


def agent_image_name(base):
    if base.startswith("rox:"):
        return f"{base}-agents"
    slug = re.sub(r"[^a-z0-9_.-]+", "-", base.lower()).strip(".-")[:100] or "image"
    return f"rox:{slug}-agents"


def prepare_agent_image(engine, base, versions):
    """Return an image of base with the agents installed in one last layer.

    Only that layer rebuilds when a new agent release comes out, so the project's .rox.sh doesn't run
    again. If the build fails, return base, and the guest installs the agents when it boots.
    """
    target = agent_image_name(base)
    spec = " ".join(agent_specs(versions))
    with file_lock(state_root() / f"image-{target.replace(':', '-')}.lock"):
        base_info = image_info(engine, base)
        if base_info is None:
            run([engine, "image", "pull", base])
            base_info = image_info(engine, base)
        if base_info is None:
            raise Error(f"Base image {base} is not available to {engine}")
        wanted = {"io.rox.agents": spec, "io.rox.agents-base": base_info[0]}
        current = image_info(engine, target)
        if current and all(current[1].get(key) == value for key, value in wanted.items()):
            return target
        reason = ("first build" if not current else
                  "new agent versions" if current[1].get("io.rox.agents") != spec else "base image changed")
        print(f"Installing {describe_agents(versions)} in {target} ({reason})", flush=True)
        with tempfile.TemporaryDirectory(prefix="rox-agents-") as context:
            context = Path(context)
            shutil.copy(HERE / "guest" / "bootstrap.sh", context / "bootstrap.sh")
            install = ["env", "HOME=/home/workspace", "bash", "/usr/local/share/rox/bootstrap.sh", "agents",
                       *agent_specs(versions)]
            (context / "Containerfile").write_text(AGENT_CONTAINERFILE.format(base=base, install=json.dumps(install)))
            try:
                run([engine, "build", "--file", str(context / "Containerfile"), "--tag", target,
                     *[f"--label={key}={value}" for key, value in wanted.items()], str(context)])
            except subprocess.CalledProcessError:
                print(f"rox: Could not install the agents in {target}. See the build output above. "
                      "The guest installs them when it boots instead.", file=sys.stderr, flush=True)
                return base
        built = image_info(engine, target)
        if engine != "container" and current and built and built[0] != current[0]:
            # Drop the superseded image unless a workspace still uses it.
            run([engine, "rmi", current[0]], capture=True, check=False)
    return target


def agent_environment(agents):
    """The guest's agents.env, which shells and the guest's Rex server read."""
    lines = ["# Written by rox from the launcher's config. Rox replaces this file."]
    for agent, settings in sorted(agents.items()):
        for setting, variable in AGENT_CREDENTIALS[agent].items():
            if variable and setting in settings:
                lines.append(f"export {variable}={shlex.quote(settings[setting].read_text().strip())}")
    return "\n".join(lines) + "\n"


def push_agent_credentials(guest, agents):
    """Write the agents' credentials into the guest over SSH, with each secret on stdin."""
    output(remote_command(guest, ["bash", "-c", AGENT_ENV_SCRIPT]), input=agent_environment(agents), timeout=30)
    codex = agents.get("codex", {})
    if "auth_file" in codex:
        output(remote_command(guest, ["bash", "-c", CODEX_AUTH_SCRIPT]), input=codex["auth_file"].read_text(),
               timeout=30)
    elif "api_key_file" in codex:
        output(remote_command(guest, ["bash", "-c", CODEX_LOGIN_SCRIPT]),
               input=codex["api_key_file"].read_text().strip() + "\n", timeout=60)


def skill_folders(agent):
    """The launcher's skills folders for agent, each with the guest folder it's copied to."""
    folders = [(agent_home(agent) / "skills", f".{agent}/skills")]
    if agent == "codex":
        folders.append((Path.home() / ".agents" / "skills", ".agents/skills"))
    return folders


def launcher_skills(agent):
    """{guest path: launcher folder} for each skill to copy. Links are followed."""
    skills = {}
    for folder, target in skill_folders(agent):
        if not folder.is_dir():
            continue
        for entry in sorted(folder.iterdir()):
            if (re.fullmatch(SKILL_NAME_PATTERN, entry.name) and entry.name not in UNSYNCED_SKILLS
                    and (entry / "SKILL.md").is_file()):
                skills[f"{target}/{entry.name}"] = entry.resolve()
    return skills


def claude_state_file():
    configured = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(configured).expanduser() / ".claude.json" if configured else Path.home() / ".claude.json"


def read_json_object(path, description):
    try:
        value = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        print(f"rox: Could not read {description} in {path}, so guests don't get it. ({error})",
              file=sys.stderr, flush=True)
        return {}
    return value if isinstance(value, dict) else {}


def read_codex_config():
    path = agent_home("codex") / "config.toml"
    if not path.is_file():
        return {}
    if tomllib is None:
        print(f"rox: Reading {path} needs Python 3.11 or newer, so guests don't get your Codex MCP servers "
              "or settings.", file=sys.stderr, flush=True)
        return {}
    try:
        return tomllib.loads(path.read_text())
    except (OSError, ValueError) as error:
        print(f"rox: Could not read {path}, so guests don't get your Codex MCP servers or settings. ({error})",
              file=sys.stderr, flush=True)
        return {}


def remote_mcp_server(agent, server):
    """Whether an MCP server runs over the network, so a guest can reach it too."""
    if not isinstance(server, dict):
        return False
    if agent == "claude":
        return server.get("type") in ("http", "sse") and isinstance(server.get("url"), str)
    return isinstance(server.get("url"), str) and "command" not in server


def launcher_mcp_servers(agent, wanted):
    """The MCP servers to copy: every remote one for true, or the named ones."""
    if wanted is False:
        return {}
    if agent == "claude":
        servers = read_json_object(claude_state_file(), "your Claude Code MCP servers").get("mcpServers")
    else:
        servers = read_codex_config().get("mcp_servers")
    servers = servers if isinstance(servers, dict) else {}
    names = [name for name in servers if remote_mcp_server(agent, servers[name])] if wanted is True else wanted
    chosen = {}
    for name in names:
        if name not in servers:
            print(f"rox: {AGENT_NAMES[agent]} has no MCP server named {name}, so guests don't get it.",
                  file=sys.stderr, flush=True)
        elif not remote_mcp_server(agent, servers[name]):
            print(f"rox: The {name} MCP server runs a program on this machine, so guests don't get it. "
                  "Install it in the guest image to use it there.", file=sys.stderr, flush=True)
        else:
            chosen[name] = servers[name]
    return chosen


def launcher_settings(agent):
    if agent == "claude":
        settings = read_json_object(agent_home("claude") / "settings.json", "your Claude Code settings")
        return {key: value for key, value in settings.items() if key not in CLAUDE_HOST_SETTINGS}
    return {key: value for key, value in read_codex_config().items() if key not in CODEX_HOST_SETTINGS}


def toml_key(key):
    return key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key)


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(f"{toml_key(key)} = {toml_value(item)}" for key, item in value.items()) + "}"
    raise ValueError(f"can't write {type(value).__name__} values to TOML")


def dump_toml(data, prefix=()):
    """Write the plain TOML that Codex's config uses: tables, strings, numbers, booleans and arrays."""
    values = [f"{toml_key(key)} = {toml_value(value)}" for key, value in data.items() if not isinstance(value, dict)]
    tables = [(key, value) for key, value in data.items() if isinstance(value, dict)]
    if prefix and (values or not tables):
        values.insert(0, f"[{'.'.join(toml_key(part) for part in prefix)}]")
    text = "\n".join(values)
    for key, value in tables:
        text += ("\n\n" if text else "") + dump_toml(value, (*prefix, key)).rstrip("\n")
    return text + "\n" if not prefix else text


def agent_sync_plan(agents):
    """What to copy into guests for agents, read from the launcher's own setup."""
    plan = {"files": {}, "dirs": {}, "settings": {}, "mcp": {}}
    for agent, settings in sorted(agents.items()):
        sync = settings.get("sync", SYNC_DEFAULTS)
        if sync["skills"]:
            plan["dirs"].update(launcher_skills(agent))
        if sync["instructions"]:
            name = "CLAUDE.md" if agent == "claude" else "AGENTS.md"
            if (agent_home(agent) / name).is_file():
                plan["files"][f".{agent}/{name}"] = (agent_home(agent) / name).read_bytes()
        if sync["settings"]:
            plan["settings"][agent] = launcher_settings(agent)
        plan["mcp"][agent] = launcher_mcp_servers(agent, sync["mcp"])
    return plan


def describe_sync(plan):
    parts = []
    if plan["dirs"]:
        names = sorted({path.rsplit("/", 1)[1] for path in plan["dirs"]})
        parts.append(f"skills {', '.join(names)}")
    parts += [path.rsplit("/", 1)[1] for path in sorted(plan["files"])]
    for agent, servers in sorted(plan["mcp"].items()):
        if servers:
            parts.append(f"{AGENT_NAMES[agent]} MCP servers {', '.join(sorted(servers))}")
    parts += [f"{AGENT_NAMES[agent]} settings" for agent in sorted(plan["settings"])]
    return "; ".join(parts)


def safe_synced_path(path):
    parts = PurePosixPath(path).parts if isinstance(path, str) else ()
    return (len(parts) >= 2 and parts[0] in (".claude", ".codex", ".agents") and ".." not in parts
            and not PurePosixPath(path).is_absolute())


def read_guest_files(guest, paths):
    text = output(remote_command(guest, ["sh", "-c", SYNC_READ_SCRIPT, "rox", *paths]), timeout=30)
    files = {}
    for line in text.splitlines():
        path, _, data = line.partition(" ")
        if path in paths:
            files[path] = base64.b64decode(data)
    return files


def merge_synced(current, previous, keys, servers, mcp_key):
    """Replace what rox synced into a guest's agent config last time with what it syncs now."""
    for key in previous.get("keys", []):
        current.pop(key, None)
    mcp = current.get(mcp_key) if isinstance(current.get(mcp_key), dict) else {}
    for name in previous.get("mcp", []):
        mcp.pop(name, None)
    current.update(keys)
    mcp.update(servers)
    if mcp:
        current[mcp_key] = mcp
    else:
        current.pop(mcp_key, None)
    return {"keys": sorted(keys), "mcp": sorted(servers)}


def sync_agent_setup(guest, agents):
    """Copy the launcher's skills, instructions, and chosen MCP servers and settings into the guest.

    Rox records what it copied in the guest, so the next sync removes what the launcher no longer has.
    """
    plan = agent_sync_plan(agents)
    merged_files = [".claude.json", ".codex/config.toml"]
    existing = read_guest_files(guest, [SYNC_RECORD, *merged_files])
    try:
        record = json.loads(existing.get(SYNC_RECORD, b"{}"))
    except ValueError:
        record = {}
    record = record if isinstance(record, dict) else {}
    stale = [path for path in record.get("paths", []) if safe_synced_path(path)]
    owned = dict(plan["files"])
    if "claude" in plan["settings"]:
        owned[".claude/settings.json"] = (json.dumps(plan["settings"]["claude"], indent=2) + "\n").encode()
    new_record = {"paths": sorted([*owned, *plan["dirs"]])}
    private = {}

    claude_previous = record.get("claude") if isinstance(record.get("claude"), dict) else {}
    if "claude" in agents and (plan["mcp"].get("claude") or claude_previous.get("mcp")):
        try:
            state = json.loads(existing.get(".claude.json", b"{}") or b"{}")
        except ValueError:
            state = None
        if isinstance(state, dict):
            new_record["claude"] = merge_synced(state, claude_previous, {}, plan["mcp"].get("claude", {}),
                                                "mcpServers")
            state.setdefault("hasCompletedOnboarding", True)
            private[".claude.json"] = (json.dumps(state, indent=2) + "\n").encode()
        else:
            print(f"rox: {guest.name} has a ~/.claude.json rox can't read, so it doesn't get your MCP servers.",
                  file=sys.stderr, flush=True)

    codex_previous = record.get("codex") if isinstance(record.get("codex"), dict) else {}
    codex_keys = plan["settings"].get("codex", {})
    if "codex" in agents and (codex_keys or plan["mcp"].get("codex") or codex_previous.get("keys")
                              or codex_previous.get("mcp")):
        config = None
        if tomllib is not None:
            try:
                config = tomllib.loads(existing.get(".codex/config.toml", b"").decode())
            except ValueError:
                pass
        if config is not None:
            new_record["codex"] = merge_synced(config, codex_previous, codex_keys, plan["mcp"].get("codex", {}),
                                               "mcp_servers")
            try:
                private[".codex/config.toml"] = dump_toml(config).encode()
            except ValueError as error:
                print(f"rox: Could not write {guest.name}'s Codex config. ({error})", file=sys.stderr, flush=True)
        else:
            print(f"rox: Could not read {guest.name}'s ~/.codex/config.toml, so it doesn't get your Codex MCP "
                  "servers or settings.", file=sys.stderr, flush=True)
    private[SYNC_RECORD] = (json.dumps(new_record, indent=2) + "\n").encode()

    archive = io.BytesIO()
    with tarfile.open(fileobj=archive, mode="w", dereference=True) as tar:
        def add_bytes(path, data, mode):
            info = tarfile.TarInfo(path)
            info.size, info.mode, info.mtime = len(data), mode, int(time.time())
            tar.addfile(info, io.BytesIO(data))

        for path, folder in sorted(plan["dirs"].items()):
            tar.add(folder, arcname=path, filter=lambda info: None if ".git" in info.name.split("/") else info)
        for path, data in sorted(owned.items()):
            add_bytes(path, data, 0o600 if path.endswith("settings.json") else 0o644)
        for path, data in sorted(private.items()):
            add_bytes(path, data, 0o600)
    remove = sorted(set(stale) | set(plan["dirs"]))
    result = subprocess.run(remote_command(guest, ["sh", "-c", SYNC_WRITE_SCRIPT, "rox", *remove]),
                            input=archive.getvalue(), capture_output=True, timeout=120)
    if result.returncode:
        raise Error(result.stderr.decode(errors="replace").strip() or "Copying the agent setup failed")
    return describe_sync(plan)


def install_agents(guest, agents, versions):
    """Install any agent whose version the guest lacks, and give the agents their credentials and setup."""
    guest_stage(guest, "agents", *agent_specs(versions))
    push_agent_credentials(guest, agents)
    try:
        if synced := sync_agent_setup(guest, agents):
            print(f"Copied {synced} into {guest.name}", flush=True)
    except (Error, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"rox: Could not copy your agent setup into {guest.name}. ({error})", file=sys.stderr, flush=True)
    guest.agents = dict(versions)
    guest.save()


def update_agents(name, config_value=None):
    """Bring a running guest's agents up to the latest versions and refresh their credentials."""
    config_path = config_location(config_value)
    agents = agent_settings(config_for(config_path), config_path)
    if not agents:
        raise Error(f"No agents are configured in {config_path}. Add them with rox config agents")
    guest = ready_guest(name)
    versions = agent_versions(agents, refresh=True)
    with guest_lock(guest.directory, wait=True):
        guest = Guest.load(name)
        before = dict(guest.agents)
        install_agents(guest, agents, versions)
    changed = {agent: version for agent, version in versions.items() if before.get(agent) != version}
    print(f"{name} has {describe_agents(versions)}" + ("" if changed else " already"), flush=True)
    print("New shells get the credentials now. Agents that rex run starts get changed credentials after "
          f"the guest restarts with rox stop {name} and rox start {name}.", flush=True)


def update_all_agents(config_value=None):
    guests = [guest for guest in local_guests() if guest.phase == "ready" and not guest.stopped]
    if not guests:
        print("No running guests on this machine")
        return
    failed = []
    for guest in guests:
        try:
            update_agents(guest.name, config_value)
        except (Error, OSError, ValueError, subprocess.SubprocessError) as error:
            failed.append(guest.name)
            print(f"rox: Could not update {guest.name}. ({error})", file=sys.stderr, flush=True)
    if failed:
        raise Error(f"Could not update {', '.join(failed)}")


def parse_sync_options(items, servers):
    """The sync settings that --sync and --mcp ask for, or None when neither is given."""
    if items is None and not servers:
        return None
    sync = {}
    if items is not None:
        chosen = {item.strip() for item in items.split(",") if item.strip()} - {"none"}
        if unknown := sorted(chosen - set(SYNC_DEFAULTS)):
            raise Error(f"Unknown --sync item {unknown[0]}. Use {', '.join(SYNC_DEFAULTS)} or none")
        sync = {item: item in chosen for item in SYNC_DEFAULTS}
    if servers:
        sync["mcp"] = list(dict.fromkeys(servers))
    return sync


def describe_agent_sync(agent, sync):
    """Say what new guests get from this machine's setup for agent."""
    plan = agent_sync_plan({agent: {"sync": sync}})
    copied = describe_sync(plan)
    print(f"New guests get {copied} from this machine" if copied else
          f"New guests get none of this machine's {AGENT_NAMES[agent]} skills, instructions or settings",
          flush=True)


def read_secret(prompt, help_text):
    """Read a token without echoing it, or a line from stdin when it's piped. Return "" when blank."""
    if sys.stdin.isatty():
        if help_text:
            print(help_text, flush=True)
        value = getpass.getpass(prompt)
    else:
        value = sys.stdin.readline()
    value = value.strip()
    if any(character.isspace() for character in value):
        raise Error("Expected a single token with no spaces")
    return value


def confirm(prompt):
    return input(f"{prompt} [Y/n] ").strip().lower() in ("", "y", "yes")


def codex_auth_location():
    return Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser() / "auth.json"


def configure_agents(args):
    """Save agent credentials next to the config and point the config's agents section at them."""
    config_path = config_location(args.config)
    if args.version and not (args.version == "latest" or re.fullmatch(VERSION_PATTERN, args.version)):
        raise Error("Expected latest or a version such as 1.2.3 for --version")
    sync = parse_sync_options(args.sync, args.mcp)
    if args.agent is None:
        if args.off or args.version or args.api_key or args.auth_file or sync is not None:
            raise Error("Name the agent these options are for: rox config agents claude or rox config agents codex")
        if not sys.stdin.isatty():
            raise Error("Name the agent to set up: rox config agents claude or rox config agents codex")
        chosen = [agent for agent in AGENT_CREDENTIALS if confirm(f"Install {AGENT_NAMES[agent]} in new guests?")]
        if not chosen:
            print("No agents chosen. Nothing changed.")
            return
    else:
        chosen = [args.agent]
    if args.agent != "codex" and args.auth_file:
        raise Error("--auth-file is for codex")

    updates = {}
    configured = config_for(config_path).get("agents")
    configured = configured if isinstance(configured, dict) else {}
    for agent in chosen:
        if args.off:
            updates[agent] = None
            continue
        if (sync is not None and not (args.version or args.api_key or args.auth_file)
                and isinstance(configured.get(agent), dict)):
            # Changing only what's copied keeps the credentials, so there's nothing to ask for.
            updates[agent] = "keep"
            continue
        if agent == "claude":
            value = read_secret("Claude Code token or Anthropic API key: ",
                                "Run claude setup-token to create a long-lived token for your Claude subscription, "
                                "or paste an Anthropic API key. Leave it blank to install Claude Code without one.")
            if not value:
                updates[agent] = {}
            else:
                updates[agent] = {"api_key_file" if value.startswith("sk-ant-api") else "token_file": value}
        else:
            auth = Path(args.auth_file).expanduser().resolve() if args.auth_file else codex_auth_location()
            use_auth = not args.api_key and (args.auth_file or (auth.is_file() and (
                not sys.stdin.isatty() or args.agent or confirm(f"Use your Codex login in {auth}?"))))
            if use_auth:
                configured_file(auth)
                if auth.stat().st_mode & 0o077:
                    raise Error(f"{auth} holds your Codex login, so only you may read it. Run chmod 600 {auth}")
                updates[agent] = {"auth_file": auth}
            else:
                value = read_secret("OpenAI API key: ", "Paste an OpenAI API key, or leave it blank to install "
                                    "Codex without one. To use your ChatGPT login instead, run codex login first.")
                updates[agent] = {"api_key_file": value} if value else {}

    with locked_config(config_path) as config:
        current = config.get("agents")
        if current is not None and not isinstance(current, dict):
            raise Error(f"Expected an object for agents in {config_path}")
        current = dict(current or {})
        for agent, update in updates.items():
            previous = current.get(agent) if isinstance(current.get(agent), dict) else {}
            # Delete the secrets rox saved for this agent that the new settings no longer use.
            for (owner, setting), filename in AGENT_SECRET_FILES.items():
                if owner == agent and update != "keep" and (update is None or setting not in update):
                    config_path.with_name(filename).unlink(missing_ok=True)
            if update is None:
                current[agent] = False
                print(f"New guests won't get {AGENT_NAMES[agent]}", flush=True)
                continue
            kept = previous.get("sync") if isinstance(previous.get("sync"), dict) else {}
            if update == "keep":
                settings = dict(previous, sync=sync_settings(agent, {**kept, **sync}, config_path))
                current[agent] = settings
                describe_agent_sync(agent, settings["sync"])
                continue
            # What the agent copies carries over unless --sync or --mcp changes it.
            settings = {"sync": sync_settings(agent, {**kept, **sync}, config_path)} if sync is not None else (
                {"sync": kept} if kept else {})
            version = args.version or previous.get("version")
            if version and version != "latest":
                settings["version"] = version
            for setting, value in update.items():
                if isinstance(value, str):
                    path = config_path.with_name(AGENT_SECRET_FILES[agent, setting])
                    write_private(path, value + "\n")
                    print(f"Saved the {AGENT_NAMES[agent]} credential to {path}", flush=True)
                    value = path
                settings[setting] = str(value)
            current[agent] = settings
            pinned = f" {settings['version']}" if "version" in settings else ", kept at the latest version"
            login = "with no credentials" if not update else "signed in"
            print(f"New guests get {AGENT_NAMES[agent]}{pinned}, {login}", flush=True)
            describe_agent_sync(agent, sync_settings(agent, settings.get("sync"), config_path))
            if "auth_file" in update:
                print("Each guest refreshes this login on its own. If guests sign each other out, "
                      "use rox config agents codex --api-key instead.", flush=True)
        if current:
            config["agents"] = current
        else:
            config.pop("agents", None)
        write_config(config_path, config)
    if not args.off:
        print("Guests that are already running get the change with rox update-agents NAME, "
              "or rox update-agents --all", flush=True)


def guest_rex(guest, *args):
    """A rex command for the guest's own server, with the same login PATH as the guest bootstrap."""
    return ["sh", "-c", 'export PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"; exec "$@"',
            "rox", "rex", "--autostart=false", "-S", f"unix://{guest.guest_socket}", *args]


def tailscale_on(guest, tags=(), control_url="", auth_key=None):
    """Turn on the guest server's tailnet node. The auth key goes over SSH on stdin, never in argv."""
    argv = guest_rex(guest, "server", "tailscale", "on", "--hostname", guest.name, "--json")
    for tag in tags:
        argv += ["--advertise-tag", tag]
    if tags:
        # A tagged node belongs to its tags rather than a person, so the tailnet ACLs decide who may connect.
        argv.append("--allow-tailnet-members")
    if control_url:
        argv += ["--control-url", control_url]
    if auth_key is not None:
        argv += ["--auth-key-file", "-"]
    output(remote_command(guest, argv), input=auth_key or "", timeout=30)


def tailnet_status(guest):
    status = json.loads(output([*rex_on(guest), "server", "status", "--json"], timeout=8))
    return status.get("tailscale") or {}


def enable_tailnet(guest, settings, timeout):
    print(f"Adding {guest.name} to the tailnet", flush=True)
    tailscale_on(guest, settings["tags"], settings["control_url"], settings["key"].read_text().strip())

    # The node reports needs_login for a moment while Tailscale processes the key, so only a node
    # still waiting for a sign-in when time runs out means the key was rejected.
    last = {}

    def running():
        last.update(state=tailnet_status(guest))
        state = last["state"]
        return state["dns_name"].rstrip(".") if state.get("state") == "running" and state.get("dns_name") else None

    try:
        guest.tailnet_name = wait_for(running, min(timeout, 60), "the guest to join the tailnet")
    except Error:
        if last.get("state", {}).get("state") == "needs_login":
            raise Error("Tailscale still wants a browser sign-in, so the auth key was rejected. "
                        "Check that it's valid, reusable, and allowed to use the configured tags") from None
        raise
    guest.save()
    # Rex serves the tailnet over HTTPS, and other devices are refused until Tailscale issues the
    # node's certificate, which takes a few seconds after it joins.
    try:
        wait_for(lambda: tailnet_status(guest).get("https", {}).get("state") == "available",
                 min(timeout, 90), "the guest's tailnet HTTPS certificate")
    except Error:
        print(f"rox: {guest.name} joined the tailnet, but its HTTPS certificate isn't ready yet. "
              "Other devices can reach it once Tailscale issues one.", file=sys.stderr, flush=True)
    print(f"{guest.name} is on the tailnet at {guest.tailnet_name}", flush=True)


def resume_tailnet(guest, settings=None):
    """Serve over the tailnet again after a server restart.

    The saved node identity usually needs no key, but Tailscale deletes an ephemeral node that
    stays offline, so send the configured key too when there is one.
    """
    try:
        if tailnet_status(guest).get("state") != "running":
            key = settings["key"].read_text().strip() if settings else None
            tags, control_url = (settings["tags"], settings["control_url"]) if settings else ((), "")
            tailscale_on(guest, tags, control_url, key)
            wait_for(lambda: tailnet_status(guest).get("state") == "running", 30, "the guest to rejoin the tailnet")
    except (Error, ValueError, subprocess.SubprocessError) as error:
        print(f"rox: {guest.name} could not rejoin the tailnet, so only this machine can reach it. ({error})",
              file=sys.stderr, flush=True)


def leave_tailnet(guest):
    """Sign the guest's node out so it doesn't linger on the tailnet after the guest is gone."""
    if guest.tailnet_name and guest.guest_socket:
        try:
            run(remote_command(guest, guest_rex(guest, "server", "tailscale", "logout")),
                capture=True, check=False, timeout=20)
        except subprocess.TimeoutExpired:
            print(f"rox: Could not sign {guest.name} out of the tailnet. Remove it in the Tailscale admin "
                  "console if it's still listed.", file=sys.stderr, flush=True)


def register_guest(guest):
    if not guest.registered:
        # The socket works only on this machine. Devices that share this Rex home skip it and use
        # the tailnet name.
        endpoints = [guest.endpoint, *([guest.tailnet_name] if guest.tailnet_name else [])]
        run(["rex", "hosts", "add", guest.name, *endpoints])
        guest.registered = True
        guest.save()
        print(f"Registered Rex host {guest.name} at {', '.join(endpoints)}", flush=True)
        if not guest.tailnet_name:
            print(f"Only this machine can reach {guest.name}. Configure tailscale in the rox config "
                  "to reach guests from other devices.", flush=True)


def launcher_hosts():
    """(label, endpoints) for the Rex hosts a guest can reach: this machine's hosts and this machine.

    Guests are left out, and so are socket endpoints, which work only on this machine. This
    machine is added by its tailnet name when no host already points there.
    """
    listing = json.loads(output(["rex", "hosts", "list", "--json"], timeout=15))
    hosts, seen = [], set()
    for entry in listing.get("hosts", []):
        host = entry.get("host", {})
        label = host.get("label") or ""
        endpoints = [endpoint for endpoint in host.get("endpoints", []) if not endpoint.startswith("unix:")]
        if (not label or not endpoints or set(endpoints) <= seen
                or re.fullmatch(NAME_PATTERN, label.split(".", 1)[0])):
            continue
        hosts.append((label, endpoints))
        seen.update(endpoints)
        # A host may give this machine's tailnet name as https://NAME.
        seen.update(re.sub(r"^https://|/$", "", endpoint) for endpoint in endpoints)
    try:
        status = json.loads(output(["rex", "--autostart=false", "--timeout", "5s", "server", "status", "--json"],
                                   timeout=10))
    except (Error, ValueError, subprocess.SubprocessError):
        status = {}
    tailscale = status.get("tailscale") or {}
    own = (tailscale.get("dns_name") or "").rstrip(".")
    if tailscale.get("state") == "running" and own and own not in seen:
        label = socket.gethostname().split(".", 1)[0].lower() or own
        if label.lower() in {name.lower() for name, _ in hosts}:
            label = own
        hosts.append((label, [own]))
    return hosts


def share_launcher_hosts(guest):
    """Add this machine's Rex hosts to the guest's own server, so Rex in the guest can reach them."""
    try:
        wanted = launcher_hosts()
        if not wanted:
            return
        # Rex in the guest reads hosts from its home, which defaults to a server the guest doesn't
        # run. Make the guest's own server the home, for rox and for every terminal in the guest.
        output(remote_command(guest, guest_rex(guest, "home", "set", f"unix://{guest.guest_socket}")), timeout=20)
        listing = json.loads(output(remote_command(guest, guest_rex(guest, "hosts", "list", "--json")), timeout=20))
        have = {entry.get("host", {}).get("label", "").lower() for entry in listing.get("hosts", [])}
        added = []
        for label, endpoints in wanted:
            if label.lower() in have or label.lower() == guest.name:
                continue
            output(remote_command(guest, guest_rex(guest, "hosts", "add", label, *endpoints)), timeout=20)
            added.append(label)
    except (Error, ValueError, subprocess.SubprocessError) as error:
        print(f"rox: Could not add this machine's Rex hosts to {guest.name}, so Rex there can't reach them "
              f"by label. ({error})", file=sys.stderr, flush=True)
        return
    if added:
        print(f"Added Rex hosts {', '.join(added)} to {guest.name}", flush=True)


def app_clients(server=None):
    """The Rex apps connected to a server, this machine's by default."""
    target = ["-S", server] if server else []
    clients = json.loads(output(["rex", "--autostart=false", "--timeout", "5s", *target, "client", "ls", "--json"],
                                timeout=10))
    return [client for client in clients.get("clients", [])
            if client.get("info", {}).get("kind") == "app" and client.get("connection_state") == "connected"]


def local_app():
    """The Rex app running on this machine and connected to its server, if any."""
    try:
        return next((client for client in app_clients()
                     if client.get("principal", {}).get("transport") == "unix"), None)
    except (Error, ValueError, subprocess.SubprocessError):
        return None


def local_app_client():
    """Return the ID of a Rex app connected to this machine's server, if any."""
    app = local_app()
    return app["client_id"] if app else None


def open_in_app(name, server, session_id, address=None, timeout=180):
    """Show the guest's own session in the Rex app here, so its splits and tabs run in the guest.

    The app stays connected to every host in its list. When the guest isn't one of them, open
    Add Remote Host with the guest's address copied, wait for the app to connect to the guest's
    server, then select the session through that connection.
    """
    app = local_app()
    if not app:
        raise Error(f"Open the Rex app on this machine to open {name} in it, or use rox shell {name}")
    device = app.get("info", {}).get("label") or app.get("label")

    def guest_app():
        try:
            return next((client["client_id"] for client in app_clients(server)
                         if not device or (client.get("info", {}).get("label") or client.get("label")) == device), None)
        except (Error, ValueError, subprocess.SubprocessError):
            return None

    client = guest_app()
    if not client:
        add_app_host(name, address or server)
        print(f"Waiting for the Rex app to connect to {name}...", flush=True)
        client = wait_for(guest_app, timeout, f"the Rex app to connect to {name}")
    result = run(["rex", "--autostart=false", "-S", server, "-C", client, "do", "session.select",
                  f"session_id={session_id}"], check=False, capture=True, timeout=15)
    if result.returncode:
        raise Error(f"The Rex app is on {name}, but couldn't open session {session_id}: "
                    f"{(result.stderr or result.stdout).strip()}")
    print(f"Opened {name} in the Rex app. Splits and new tabs there run in the guest.", flush=True)


def guest_session(guest, key=None):
    """The guest's own Rex session for a project, its only project, or the guest itself."""
    if key:
        return guest.find_project(key).session_id
    if len(guest.projects) == 1:
        return guest.projects[0].session_id
    return guest.session_id or (guest.projects[0].session_id if guest.projects else "")


def open_guest(name, key=None, host=None):
    """rox open: show a guest here or on another Rex host in the Rex app on this machine."""
    if host is None and is_local(name):
        guest = ready_guest(name)
        session = guest_session(guest, key)
        server, address = guest.endpoint, guest.tailnet_name or guest.endpoint
    else:
        host, record = find_remote_guest(name, host)
        if not record.get("tailnet"):
            raise Error(f"{name} runs on {host} and isn't on the tailnet, so the Rex app here can't reach it. "
                        f"Use rox shell {name}, or configure tailscale on {host} with rox config tailscale")
        if "sessions" not in record:
            raise Error(f"Upgrade rox on {host} to open its guests in the Rex app from here")
        sessions = record["sessions"]
        session = sessions.get(key) if key else (sessions.get("") or next(iter(sessions.values()), ""))
        server = address = record["tailnet"]
    if not session:
        raise Error(f"{name} has no Rex session for {key or 'the guest'} yet. Run rox reconnect {name}")
    open_in_app(name, server, session, address)


def open_or_tab(app_session, guest, project=None):
    """For --open-shell: open the guest's own session in the Rex app, or a Guest tab without an app."""
    if local_app():
        open_in_app(guest.name, guest.endpoint, project.session_id if project else guest.session_id,
                    guest.tailnet_name or guest.endpoint)
    else:
        open_app_shell(app_session, guest.name, project.id if project else None)


def add_app_host(name, address):
    """Add a guest to the Rex app on this machine, which keeps its own host list.

    Such apps ignore `rex hosts add`, and their Add Remote Host dialog takes no
    arguments, so copy the address and open the dialog for the user to paste.
    """
    client = local_app_client()
    if not client:
        raise Error("Open the Rex app on this machine, then run this again")
    copied = bool(shutil.which("pbcopy")) and run(["pbcopy"], input=address, check=False).returncode == 0
    result = run(["rex", "--autostart=false", "-C", client, "do", "client.host.add"],
                 check=False, capture=True, timeout=8)
    if result.returncode:
        raise Error(f"Could not open Add Remote Host in the Rex app, so add {address} there yourself. "
                    f"({(result.stderr or result.stdout).strip()})")
    if copied:
        print(f"Copied {address}. Paste it into Add Remote Host in the Rex app to add {name}.", flush=True)
    else:
        print(f"Enter {address} in Add Remote Host in the Rex app to add {name}.", flush=True)


def add_remote_host(name, host=None):
    """Add a guest, here or on another Rex host, to the Rex app on this machine."""
    if host is None and is_local(name):
        guest = Guest.load(name)
        if not guest.registered:
            raise Error(f"{name} isn't a Rex host yet. Run rox reconnect {name} first")
        # A tailnet name works from the app on any device. The socket works only here.
        add_app_host(name, guest.tailnet_name or guest.endpoint)
        return
    host, record = find_remote_guest(name, host)
    if not record.get("tailnet"):
        raise Error(f"{name} runs on {host} and isn't on the tailnet, so only {host} can reach it. "
                    f"Run rox add-remote-host {name} there, or configure tailscale on {host} with "
                    "rox config tailscale")
    add_app_host(name, record["tailnet"])


def suggest_app_host(name):
    """Point to rox add-remote-host when a Rex app here keeps its own host list."""
    if local_app_client():
        print(f"To add {name} to the Rex app's host list, run rox add-remote-host {name}", flush=True)


def describe_guest(guest, project=None):
    print(f"Workspace  {guest.name}")
    if guest.tailnet_name:
        print(f"Tailnet    {guest.tailnet_name}")
    if guest.agents:
        print(f"Agents     {describe_agents(guest.agents)}")
    if guest.git_keys:
        print(f"Git keys   {', '.join(Path(key).name for key in guest.git_keys)} (forwarded, never copied)")
    target = guest.name if guest.registered else guest.endpoint
    if project:
        print(f"Project    {project.id}")
        print(f"Checkout   {project.workspace}")
    session = project.session_id if project else guest.session_id
    if session:
        print(f"Session    {session}")
        print(f"Inspect    rex -S {target} session inspect {session}")
    else:
        print(f"Inspect    rex -S {target} ls")


def project_options(project):
    if not project:
        return ["--no-project"]
    name, url, branch = project
    return [f"--project={name}", f"--repo={url}", f"--branch={branch}"]


# Rex starts remote commands with its own PATH, which may lack the release install's ~/.local/bin.
REMOTE_ROX = ["sh", "-c", 'PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"; exec rox "$@"', "rox"]


def dispatch(args, label, launch, command):
    """Run a rox command on a Rex remote host in a Provision tab and wait for it.

    The session closes when the command succeeds, and stays open to inspect when it fails.
    """
    rex = ["rex", "--autostart=false", "-S", args.host]
    launch = [*REMOTE_ROX, *launch]
    for option in ("config", "image", "engine", "cpus", "memory", "git_known_hosts"):
        if (value := getattr(args, option, None)) is not None:
            launch.append(f"--{option.replace('_', '-')}={value}")
    launch.extend(f"--git-key={key}" for key in getattr(args, "git_key", None) or [])
    for flag in ("no_hook", "no_prebuild", "rebuild", "no_app_host", "no_tailscale", "no_agents",
                 "no_git_agent"):
        if getattr(args, flag, False):
            launch.append(f"--{flag.replace('_', '-')}")
    if command:
        launch.extend(["--", *command])

    created = json.loads(output([
        *rex, "new", "--window", "Provision", "--keep-open", "--json",
        f"rox {label}", "--", *launch,
    ]))
    session = created["session_id"]
    block = created["initial_windows"][0]["block_ids"][0]
    print(f"Provisioning {label} on {args.host} in Rex session {session}", flush=True)
    status = run([*rex, "wait", "-s", session, block], check=False)
    capture = run([*rex, "capture", "-s", session, "-b", block, "--trim", "--unwrap"],
                  check=False, capture=True)
    if capture.returncode == 0 and capture.stdout.strip():
        print(capture.stdout.rstrip())
    if status.returncode:
        raise Error(f"Provisioning exited with status {status.returncode}. See the Provision tab in {session} on {args.host}.")
    closed = run([*rex, "kill", session], check=False, capture=True)
    if closed.returncode:
        print(f"rox: Could not close the Provision tab in {session} on {args.host}. "
              f"({closed.stderr.strip()})", file=sys.stderr, flush=True)
    return capture.stdout if capture.returncode == 0 else ""


def register_remote_guest(provision_output, launcher):
    """Add a guest launched on another host to this machine's Rex hosts, by its tailnet name.

    Each Rex home keeps its own host list, so the launcher's entry may not reach this machine.
    """
    workspace = re.search(rf"^Workspace\s+({NAME_PATTERN})\s*$", provision_output, re.MULTILINE)
    tailnet = re.search(r"^Tailnet\s+([a-z0-9-]+(?:\.[a-z0-9-]+)+)\s*$", provision_output, re.MULTILINE)
    if not workspace:
        return
    if not tailnet:
        print(f"{workspace[1]} is reachable only on {launcher}, because it isn't on the tailnet. "
              f"Configure tailscale in the rox config on {launcher} to reach guests from here.", flush=True)
        return
    result = run(["rex", "hosts", "add", workspace[1], tailnet[1]], capture=True, check=False)
    if result.returncode:
        print(f"rox: Could not add {workspace[1]} to this machine's Rex hosts. Use rex -S {tailnet[1]} instead. "
              f"({result.stderr.strip()})", file=sys.stderr, flush=True)
        return
    print(f"Registered Rex host {workspace[1]} on this machine at {tailnet[1]}", flush=True)
    suggest_app_host(workspace[1])


def open_remote_guest(provision_output, launcher):
    """After a remote up or add, open the guest's session in the Rex app here when it can reach it."""
    workspace = re.search(rf"^Workspace\s+({NAME_PATTERN})\s*$", provision_output, re.MULTILINE)
    tailnet = re.search(r"^Tailnet\s+([a-z0-9-]+(?:\.[a-z0-9-]+)+)\s*$", provision_output, re.MULTILINE)
    session = re.search(r"^Session\s+(session:\S+)\s*$", provision_output, re.MULTILINE)
    if not workspace:
        return
    if not (tailnet and session and local_app()):
        print(f"Open a shell in it with rox shell {workspace[1]}", flush=True)
        return
    try:
        open_in_app(workspace[1], tailnet[1], session[1])
    except Error as error:
        print(f"rox: {error}. Open it later with rox open {workspace[1]}", file=sys.stderr, flush=True)


def down_remote(args):
    """Remove a guest on a Rex remote host, and this machine's host entry for it."""
    if not args.name or not re.fullmatch(NAME_PATTERN, args.name):
        raise Error("Name the workspace to remove on another host: rox down NAME --host HOST")
    dispatch(args, args.name, ["down", args.name], [])
    if not remove_rex_host(args.name):
        raise Error(f"Removed {args.name} on {args.host}, but could not remove its Rex host on this machine")


def open_app_shell(session, name, project_id=None):
    """Open a Guest tab running rox shell, and remember it so rox down can close it."""
    created = json.loads(output([
        "rex", "--autostart=false", "window", "new", "-s", session, "--keep-open", "--json",
        "Guest", "--", str(Path(__file__).resolve()), "shell", name, *([project_id] if project_id else [])]))
    window = created.get("window_id")
    if window:
        guest = Guest.load(name)
        with guest_lock(guest.directory, wait=True):
            guest = Guest.load(name)
            guest.shell_windows.append({"session": session, "window": window})
            guest.save()


def close_shell_windows(guest):
    """Close the guest's Guest tabs, and a session that has nothing left in it, such as a Provision one."""
    rex = ["rex", "--autostart=false", "--timeout", "5s"]
    for entry in guest.shell_windows:
        run([*rex, "window", "close", "-s", entry["session"], entry["window"]], capture=True, check=False, timeout=15)
        listing = run([*rex, "window", "ls", "-s", entry["session"], "--json"], capture=True, check=False, timeout=15)
        try:
            remaining = json.loads(listing.stdout).get("windows") if listing.returncode == 0 else None
        except ValueError:
            remaining = None
        if remaining == []:
            run([*rex, "kill", entry["session"]], capture=True, check=False, timeout=15)


def remove_rex_host(name):
    """Remove a Rex host entry, which is done already when there's no such host."""
    result = run(["rex", "hosts", "remove", name], capture=True, check=False)
    return result.returncode in (0, 3) or "no host has that label" in result.stderr


def app_session_for(args):
    if not args.open_shell:
        return None
    session = os.environ.get("REX_SESSION")
    if not session:
        raise Error("--open-shell requires a Rex terminal")
    return session


def load_config(args):
    path = config_location(args.config)
    if args.config:
        configured_file(path)
    return path, config_for(path)


def require(tools):
    for tool in tools:
        if not shutil.which(tool):
            raise Error(f"Install {tool} and make it available on PATH")


# The identities ssh tries when none is configured, in its own order.
DEFAULT_SSH_KEYS = ("id_rsa", "id_ecdsa", "id_ecdsa_sk", "id_ed25519", "id_ed25519_sk")


def default_git_keys(url, quiet=False):
    """The launcher's default SSH identities, which git clone on the launcher would use too."""
    keys = [path for name in DEFAULT_SSH_KEYS if (path := Path.home() / ".ssh" / name).is_file()]
    if quiet:
        return keys
    if not keys:
        print(f"rox: No Git SSH key is configured and ~/.ssh has none of ssh's default keys, so the guest "
              f"probably can't clone {url}. Add a key with rox key add PATH, or clone over HTTPS with --repo",
              file=sys.stderr, flush=True)
        return []
    names = ", ".join(f"~/.ssh/{path.name}" for path in keys)
    print(f"Using your default SSH {'key' if len(keys) == 1 else 'keys'} {names} for Git. "
          "Choose others with rox key add PATH", flush=True)
    return keys


def git_access(args, config, config_path, url):
    """Return the launcher's Git SSH keys and pinned server keys for cloning url."""
    keys = args.git_key if args.git_key is not None else config.get("git_keys")
    if urlsplit(url).scheme == "https":
        validate_git_keys(keys or [], config_path)
        return [], ""
    # Without configured keys, use the ones ssh would. An explicit empty list means no keys.
    keys = default_git_keys(url) if keys is None else validate_git_keys(keys, config_path)
    keys = [configured_file(key) for key in keys]
    known_hosts_option = args.git_known_hosts or config.get("git_known_hosts")
    require((["ssh-agent", "ssh-add"] if keys else []) + ([] if known_hosts_option else ["ssh-keygen"]))
    return keys, git_host_entries(url, known_hosts_option)


def guest_git_keys(args, config, config_path):
    """The keys to keep forwarded into the guest: the configured Git keys, or the default ones."""
    enabled = config.get("git_agent", True)
    if not isinstance(enabled, bool):
        raise Error(f"Expected true or false for git_agent in {config_path}")
    if not enabled or getattr(args, "no_git_agent", False):
        return []
    keys = args.git_key if getattr(args, "git_key", None) is not None else config.get("git_keys")
    keys = default_git_keys("", quiet=True) if keys is None else validate_git_keys(keys, config_path)
    return [str(configured_file(key)) for key in keys]


def start_session(guest, label, cwd, command):
    launch = ["rex", "--autostart=false", "-S", f"unix://{guest.guest_socket}",
              "new", label, "-c", str(cwd), "--json"]
    if command:
        launch += ["--keep-open", "--", *command]
    created = json.loads(guest_stage(guest, "session", *launch, capture=True))
    if not created.get("session_id"):
        raise Error("Rex did not return a session ID")
    return created["session_id"]


def provision_project(guest, source, command, keys, known_hosts, no_hook, image_checkout=False):
    """Clone a project into a ready guest, run its hook and start a Rex session at the checkout."""
    name, url, branch = source
    project = guest.add_project(name, url, branch)
    # A project image keeps its prepared checkout at a fixed path beside the per-guest state.
    project.workspace = str(guest.base.parent / "image" / "project" if image_checkout
                            else guest.base / "projects" / project.id)
    guest.save()
    print(f"Adding {name} ({branch}) to {guest.name} as {project.id}", flush=True)
    try:
        if known_hosts:
            target = str(PurePosixPath(project.workspace).parent / "git_known_hosts")
            upload = ["bash", "-c", 'umask 077; mkdir -p "${1%/*}" && cat > "$1"', "rox", target]
            run(remote_command(guest, upload), input=known_hosts)
        with git_agent(guest, keys) as agent:
            guest_stage(guest, "clone", project.workspace, url, branch, "yes" if agent else "no", agent=agent)
        guest_stage(guest, "setup", project.workspace, guest.name, guest.backend, guest.guest_socket,
                    "prebuilt" if image_checkout else str(no_hook).lower())
        project.session_id = start_session(guest, name, project.workspace, command)
        guest.save()
        attach_guest(guest, project.session_id)
        project.phase = "ready"
        guest.save()
    except (Exception, KeyboardInterrupt):
        project.phase = "failed"
        guest.save()
        print(f"Setting up {project.id} failed. Rex host {guest.name} is still available.", file=sys.stderr)
        print(f"Workspace {guest.name} was retained. Run rox down {guest.name} to remove it.", file=sys.stderr)
        raise
    return project


def up(args, command):
    if args.host is not None and not args.host.strip():
        raise Error("--host needs a Rex host label or address")
    source = resolve_project(args)
    local = local_project_settings(args) if source else {}
    if args.host is not None:
        provisioned = dispatch(args, source[0] if source else "host",
                               ["up", *([args.backend] if args.backend else []), *project_options(source),
                                f"--boot-timeout={args.boot_timeout}",
                                *([f"--local-settings={json.dumps(local)}"] if local else [])], command)
        register_remote_guest(provisioned, args.host)
        open_remote_guest(provisioned, args.host)
        return
    if not source:
        print("Starting a guest without a project. Add one later with rox add NAME.", flush=True)
    app_session = app_session_for(args)
    config_path, config = load_config(args)
    keys, known_hosts = git_access(args, config, config_path, source[1]) if source else ([], "")
    tailnet = tailscale_settings(config, config_path, args.no_tailscale)
    agents = {} if args.no_agents else agent_settings(config, config_path)
    forwarded_keys = guest_git_keys(args, config, config_path)
    fetched = None
    if source:
        require(["git"])
        fetched = read_branch(source[1], source[2], keys, known_hosts)
    project_config = fetched.settings if fetched else {}
    backend = args.backend or local.get("backend") or project_config.get("backend")
    if not backend:
        raise Error(f"Choose a backend with rox up container, linux or macos, or set \"backend\" in {PROJECT_CONFIG}")
    if not args.backend:
        print(f"Using the {backend} backend from {LOCAL_CONFIG if local.get('backend') else PROJECT_CONFIG}",
              flush=True)
    launcher_settings = config.get(backend, {})
    if not isinstance(launcher_settings, dict):
        raise Error(f"Expected an object for {backend} in {config_path}")
    project_section = project_config.get(backend, {})
    local_section = local.get(backend, {})
    # The branch's settings override the launcher's, the checkout's override the branch's, and
    # command-line options override them all.
    settings = {**launcher_settings, **project_section, **local_section}

    def origin(key):
        return LOCAL_CONFIG if key in local_section else PROJECT_CONFIG if key in project_section else config_path

    if args.engine and backend != "container":
        raise Error("--engine applies to the container backend")
    engine = ""
    if backend == "container":
        engine = args.engine or settings.get("engine") or default_engine()
        if engine not in ENGINES:
            raise Error("Choose container, docker or podman as the container engine")
    cpus = args.cpus if args.cpus is not None else settings.get("cpus", 0)
    memory = args.memory if args.memory is not None else settings.get("memory", "")
    if not isinstance(cpus, int) or isinstance(cpus, bool) or cpus < 0:
        where = "--cpus" if args.cpus is not None else f"{backend}.cpus in {origin('cpus')}"
        raise Error(f"Expected a whole number of CPUs for {where}")
    if not isinstance(memory, str) or (memory and not re.fullmatch(r"[0-9]+[KMGT]", memory, re.IGNORECASE)):
        where = "--memory" if args.memory is not None else f"{backend}.memory in {origin('memory')}"
        raise Error(f"Expected a size such as 4G or 512M for {where}")
    image = args.image or settings.get("image") or (DEFAULT_CONTAINER_IMAGE if engine else "")
    if not isinstance(image, str) or not image or image.startswith("-"):
        raise Error(f"Choose a {backend} image with --image or in {origin('image')}")
    identity = None
    host_key = None
    user = "workspace"
    if not engine:
        user = settings.get("user", "admin")
        identity = configured_file(settings.get("identity"))
        host_key = configured_file(settings.get("host_key"))
        if not identity or not host_key or not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_.-]*", user):
            raise Error(f"Configure user, identity and host_key for {backend} in {config_path}")
    prebuild = settings.get("prebuild", True)
    if not isinstance(prebuild, bool):
        raise Error(f"Expected true or false for {backend}.prebuild in {origin('prebuild')}")
    prebuild = prebuild and bool(source) and not args.no_prebuild and not args.no_hook
    if args.rebuild and not prebuild:
        raise Error("--rebuild needs a project image, which --no-project, --no-hook, --no-prebuild "
                    "or prebuild: false disable")

    required = ["rex", "ssh", engine or "tart"]
    if engine:
        required.append("ssh-keygen")
    if engine == "container" and not shutil.which("container"):
        raise Error("Install Apple's container tool (https://github.com/apple/container), "
                    "or choose --engine docker or --engine podman")
    require(required)
    if engine:
        ensure_runtime(engine)
    private_directory(state_root())
    if engine:
        prepare_container_image(engine, image)
    versions = agent_versions(agents) if agents else {}
    prebuilt = ""
    if prebuild:
        vm = {"user": user, "identity": identity, "host_key": host_key, "boot_timeout": args.boot_timeout,
              "cpus": cpus, "memory": memory, "agents": versions}
        prebuilt = prepare_project_image(backend, engine, image, source[0], source[1], source[2],
                                         keys, known_hosts, vm, args.rebuild, fetched)
    launch_image = prebuilt or image
    if engine and versions:
        launch_image = prepare_agent_image(engine, launch_image, versions)

    name = f"rv-{slugify(source[0] if source else 'host', 24) or 'project'}-{secrets.token_hex(6)}"
    guest = Guest(name, backend, launch_image, user, engine, prebuilt=bool(prebuilt),
                  cpus=cpus, memory=memory, git_keys=forwarded_keys)
    guest.directory.mkdir(mode=0o700)
    guest.identity = str(identity or guest.directory / "login")
    with guest_lock(guest.directory):
        guest.save()
        print(f"Starting {guest.name}" + (f" from {source[0]} ({source[2]})" if source else ""), flush=True)
        try:
            if host_key:
                pin_host(guest, host_key.read_text())
            private_directory(guest.runtime.parent)
            private_directory(guest.runtime)
            guest.address, guest.port = launch_guest(guest, args.boot_timeout)
            guest.save()
            check_guest_os(guest, args.boot_timeout)
            paths = guest_stage(guest, "prepare", guest.name, capture=True).splitlines()
            if len(paths) != 2 or any(not path.startswith("/") or ":" in path for path in paths):
                raise Error("Guest preparation did not return valid state and socket paths")
            guest.guest_socket = paths[1]
            guest.save()
            if versions:
                # Before the Rex server starts, so it and every terminal it opens read the credentials.
                install_agents(guest, agents, versions)
            guest_stage(guest, "server", guest.guest_socket)
            attach_guest(guest)
            if tailnet:
                enable_tailnet(guest, tailnet, args.boot_timeout)
            register_guest(guest)
            share_launcher_hosts(guest)
            if not source:
                guest.session_id = start_session(guest, guest.name, guest.home, command)
                guest.save()
                attach_guest(guest, guest.session_id)
            guest.phase = "ready"
            guest.save()
        except (Exception, KeyboardInterrupt):
            guest.phase = "failed"
            guest.save()
            if guest.registered:
                print(f"Rex host {guest.name} is available even though setup failed.", file=sys.stderr)
            print(f"Workspace {guest.name} was retained. Run rox down {guest.name} to remove it.", file=sys.stderr)
            raise
        project = None
        if source:
            project = provision_project(guest, source, command, keys, known_hosts, args.no_hook,
                                        image_checkout=bool(prebuilt))
        # After the setup hook, which runs without Git keys, so only Git and agents in the guest get them.
        restore_git_agent(guest)
        describe_guest(guest, project)

    suggest_app_host(guest.name)
    if app_session:
        try:
            open_or_tab(app_session, guest, project)
        except (Error, subprocess.SubprocessError, ValueError) as error:
            raise Error(f"{guest.name} is ready. Open it on this host with rox shell {guest.name}.") from error


def add(args, command):
    """Clone another project into a guest that is already running."""
    if args.host is not None and not args.host.strip():
        raise Error("--host needs a Rex host label or address")
    if not re.fullmatch(NAME_PATTERN, args.name):
        raise Error(f"Invalid workspace name {args.name!r}")
    source = resolve_project(args, required=True)
    if args.host is not None:
        provisioned = dispatch(args, source[0], ["add", args.name, *project_options(source)], command)
        open_remote_guest(provisioned, args.host)
        return
    app_session = app_session_for(args)
    config_path, config = load_config(args)
    require(["rex", "ssh"])
    keys, known_hosts = git_access(args, config, config_path, source[1])
    guest = Guest.load(args.name)
    with guest_lock(guest.directory):
        guest = Guest.load(args.name)
        if guest.stopped:
            raise Error(f"{guest.name} is stopped. Start it with rox start {guest.name} before adding a project")
        if guest.phase != "ready" or not guest.guest_socket:
            raise Error(f"{guest.name} is {guest.phase}. Run rox reconnect {guest.name} before adding a project")
        resume(guest, saved_tailnet(guest, args.config), force=True)
        project = provision_project(guest, source, command, keys, known_hosts, args.no_hook)
        restore_git_agent(guest)
        describe_guest(guest, project)
    if app_session:
        try:
            open_or_tab(app_session, guest, project)
        except (Error, subprocess.SubprocessError, ValueError) as error:
            raise Error(f"{project.id} is ready. Open it with rox shell {guest.name} {project.id}.") from error


def shell_directory(name, checkouts, home, key=None):
    """Pick the checkout a shell opens in from (id, name, workspace) entries, or the guest home."""
    if key:
        matches = [entry for entry in checkouts if entry[0] == key] or [entry for entry in checkouts if entry[1] == key]
        if len(matches) == 1:
            return matches[0][2]
        choices = ", ".join(entry[0] for entry in checkouts) or "none"
        problem = "matches several projects" if matches else "is not a project"
        raise Error(f"{key!r} {problem} on {name}. Projects: {choices}")
    if len(checkouts) == 1:
        return checkouts[0][2]
    if checkouts:
        choices = ", ".join(entry[0] for entry in checkouts)
        print(f"{name} has several projects ({choices}). Opening the guest home; "
              f"run rox shell {name} PROJECT to open a checkout.", file=sys.stderr)
    return home


def shell_command(socket_path, directory, session=""):
    session_env = [f"REX_SESSION={session}"] if session else []
    git_agent = f"SSH_AUTH_SOCK={guest_git_socket(PurePosixPath(socket_path).parent)}"
    return ["env", f"REX_SERVER=unix://{socket_path}", git_agent, *session_env, "sh", "-c",
            'cd "$1" && exec "${SHELL:-/bin/sh}" -l', "rox", directory]


def shell(name, key=None):
    guest = ready_guest(name)
    if key:
        guest.find_project(key)  # Explain a project that isn't there, including one still cloning.
    checkouts = [(project.id, project.name, project.workspace) for project in guest.projects]
    directory = shell_directory(name, checkouts, str(guest.home), key)
    session = next((project.session_id for project in guest.projects if project.workspace == directory),
                   guest.session_id)
    argv = remote_command(guest, shell_command(guest.guest_socket, directory, session), tty=True)
    os.execvpe(argv[0], argv, {**os.environ, "TERM": "xterm-256color"})


def reconnect(name, force=True):
    """Start the guest if it stopped, and restore its tunnel, Rex server and tailnet node."""
    guest = Guest.load(name)
    with guest_lock(guest.directory):
        guest = Guest.load(name)
        if not guest.guest_socket or guest.phase == "removing":
            raise Error(f"{name} did not get far enough to start a Rex server")
        guest.stopped = False
        guest.save()
        resume(guest, saved_tailnet(guest), force=force)
        guest.phase = "ready"
        guest.save()
        describe_guest(guest)
        for project in guest.projects:
            print(f"Project    {project.id}  {project.phase}  {project.workspace}")


def stop_workspace(name):
    """Stop the guest and keep it stopped until rox start, without deleting anything."""
    guest = Guest.load(name)
    with guest_lock(guest.directory):
        guest = Guest.load(name)
        if guest.phase == "removing":
            raise Error(f"{name} is being removed")
        guest.stopped = True
        guest.save()
        stop_funnels(guest)
        stop_git_agent(guest)
        close_tunnel(guest)
        if guest_state(guest) == "running":
            stop_guest(guest)
        print(f"Stopped {name}. Start it again with rox start {name}", flush=True)


def ready_guest(name):
    """Load a guest for shell or forward, starting it again if its runtime or tunnel went away."""
    guest = Guest.load(name)
    if guest.stopped:
        raise Error(f"{name} is stopped. Start it with rox start {name}")
    if guest.phase != "ready":
        raise Error(f"{name} is not ready")
    try:
        healthy = guest_state(guest) == "running" and reachable(guest)
    except (Error, ValueError, subprocess.SubprocessError):
        healthy = False
    if healthy:
        # A restart breaks the tunnel, so a reachable guest is still at its saved address.
        return guest
    with guest_lock(guest.directory, wait=True):
        guest = Guest.load(name)
        resume(guest, saved_tailnet(guest))
    return guest


def forward_spec(value):
    """Parse PORT or LOCAL:GUEST into (local, guest) port numbers."""
    try:
        ports = [int(part) for part in value.split(":")]
    except ValueError:
        ports = []
    if len(ports) not in (1, 2) or any(not 1 <= port <= 65535 for port in ports):
        raise argparse.ArgumentTypeError(f"expected PORT or LOCAL:GUEST, got {value!r}")
    return ports[0], ports[-1]


def forward(name, ports):
    """Tunnel localhost ports on the launcher to servers on the guest's own localhost."""
    require(["ssh"])
    guest = ready_guest(name)
    tunnels = [option for local, port in ports for option in ("-L", f"127.0.0.1:{local}:127.0.0.1:{port}")]
    argv = ssh_command(guest, "-N", "-T", "-S", "none", "-o", "ForwardAgent=no",
                       "-o", "ExitOnForwardFailure=yes", *tunnels)
    for local, port in ports:
        print(f"Forwarding http://localhost:{local} to port {port} on {name}", flush=True)
    print("Press Ctrl-C to stop.", flush=True)
    os.execvp(argv[0], argv)


def close_relay(guest):
    if guest.relay_socket.is_socket():
        with socket.socket(socket.AF_UNIX) as control:
            control.settimeout(5)
            try:
                control.connect(str(guest.relay_socket))
                control.recv(1)
            except (ConnectionRefusedError, FileNotFoundError):
                pass  # The relay already stopped.


def close_tunnel(guest):
    close_relay(guest)
    if guest.control_socket.is_socket():
        run(ssh_command(guest, "-S", str(guest.control_socket), "-O", "exit"), capture=True, check=False)


def down(name):
    guest = Guest.load(name)
    with guest_lock(guest.directory):
        guest = Guest.load(name)
        guest.phase = "removing"
        guest.save()
        stop_funnels(guest)
        leave_tailnet(guest)
        stop_git_agent(guest)
        close_tunnel(guest)
        if guest.engine == "container":
            result = run(["container", "delete", "--force", name], capture=True, check=False)
            if result.returncode and "not found" not in (result.stderr + result.stdout).lower():
                raise Error(result.stderr.strip() or f"Could not delete container {name}")
        elif guest.engine:
            ids = output([guest.engine, "ps", "-aq", "--no-trunc", "--filter",
                          f"label=io.rox.workspace={name}"]).splitlines()
            for container_id in ids:
                run([guest.engine, "rm", "-f", "-v", container_id])
        else:
            vms = json.loads(output(["tart", "list", "--source", "local", "--format", "json"]))
            vm = next((vm for vm in vms if vm["Name"] == name), None)
            if vm:
                if vm["Running"]:
                    run(["tart", "stop", name])
                run(["tart", "delete", name])
        if guest.registered and not remove_rex_host(name):
            raise Error(f"Could not remove Rex host {name}")
        close_shell_windows(guest)
        if guest.runtime.is_dir():
            shutil.rmtree(guest.runtime)
        shutil.rmtree(guest.directory)
        print(f"Removed {name}")


def current_project(cwd):
    try:
        return Path(output(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"])).name
    except Error:
        raise Error("Run rox down from a project checkout or name a workspace: rox down NAME") from None


def remote_project_guests(project):
    """(host, name, backend, phase, projects) for the project's guests on other Rex hosts."""
    try:
        found, problems = gather_records("all")
    except (Error, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f"rox: Could not check other Rex hosts for workspaces. ({error})", file=sys.stderr, flush=True)
        return []
    for host, problem in problems.items():
        print(f"rox: Could not check {host} for workspaces. ({problem})", file=sys.stderr, flush=True)
    return [(host, record["name"], record.get("backend") or "-", record.get("phase") or "-",
             record.get("projects") or "-")
            for host, records in found.items() if host != "this machine" for record in records
            if any(checkout.get("name") == project for checkout in record.get("checkouts") or [])]


def choose_project_guest(cwd):
    """Pick the guest that has the current project, here or on another Rex host. Return (name, host)."""
    project = current_project(cwd)
    local = [Guest.load(path.parent.name) for path in sorted(state_root().glob("*/guest.json"))]
    guests = [(None, guest.name, guest.backend, guest.phase, project_summary(guest))
              for guest in local if any(entry.name == project for entry in guest.projects)]
    guests += remote_project_guests(project)
    if not guests:
        raise Error(f"No workspaces for {project}. Run rox ls --all to see all workspaces.")
    if len(guests) == 1:
        return guests[0][1], guests[0][0]
    listing = "\n".join(f"  {index}) {name}  {f'on {host}  ' if host else ''}{backend}  {phase}  {projects}"
                        for index, (host, name, backend, phase, projects) in enumerate(guests, 1))
    if not sys.stdin.isatty():
        raise Error(f"{project} has {len(guests)} workspaces. Choose one with rox down NAME:\n{listing}")
    print(f"{project} has {len(guests)} workspaces:\n{listing}")
    try:
        answer = input(f"Remove which workspace? [1-{len(guests)}] ").strip()
    except EOFError:
        answer = ""
    if not answer.isdigit() or not 1 <= int(answer) <= len(guests):
        raise Error("No workspace selected")
    host, name = guests[int(answer) - 1][:2]
    return name, host


def project_summary(guest):
    entries = [f"{project.id}:{project.branch}" + ("" if project.phase == "ready" else f" ({project.phase})")
               for project in guest.projects]
    return ", ".join(entries) or "-"


def guest_ip(guest):
    """The address the launch machine can reach the guest's servers at.

    Tart VMs and Apple's containers have their own address. Docker and Podman
    containers are reached through a loopback SSH port instead, so they have none.
    """
    return guest.address if guest.address and guest.engine in ("", "container") else "-"


def local_records():
    records = []
    for path in sorted(state_root().glob("*/guest.json")):
        guest = Guest.load(path.parent.name)
        records.append({
            "name": guest.name, "backend": guest.backend, "engine": guest.engine,
            "phase": "stopped" if guest.stopped and guest.phase == "ready" else guest.phase,
            "ip": guest_ip(guest), "tailnet": guest.tailnet_name, "projects": project_summary(guest),
            # What another machine needs to open a shell in the guest through its tailnet Rex server.
            "socket": guest.guest_socket, "home": str(guest.home) if guest.guest_socket else "", "user": guest.user,
            "checkouts": [{"id": project.id, "name": project.name, "workspace": project.workspace}
                          for project in guest.projects if project.workspace],
            "funnels": [{"url": f["url"], "port": f["port"]} for f in guest.funnels],
            # Rex sessions in the guest's own server: "" for the guest's, and one per project.
            "sessions": {**({"": guest.session_id} if guest.session_id else {}),
                         **{project.id: project.session_id for project in guest.projects if project.session_id}},
        })
    return records


def record_row(record):
    return "\t".join(record[key] or "-" for key in ("name", "backend", "phase", "ip", "projects"))


def rex_host_labels():
    """Labels of the Rex hosts this machine knows, leaving out rox guests, which aren't launchers."""
    listing = json.loads(output(["rex", "hosts", "list", "--json"], timeout=15))
    labels = [entry["host"]["label"] for entry in listing.get("hosts", []) if entry.get("host", {}).get("label")]
    # The Rex app may label a guest by its tailnet name, such as rv-web-0123456789ab.tail1234.ts.net.
    return [label for label in labels if not re.fullmatch(NAME_PATTERN, label.split(".", 1)[0])]


def server_id(server=None):
    target = ["-S", server] if server else []
    status = json.loads(output(["rex", "--autostart=false", "--timeout", "5s", *target, "server", "status", "--json"],
                               timeout=10))
    return status.get("host_id", "")


LIST_COMMAND = ["sh", "-c", 'PATH="$HOME/.local/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"; '
                'rox ls --json 2>/dev/null || { echo "#rox-plain"; rox ls; }']


def rex_output(server, label, argv, wait=30):
    """Run argv in a short-lived session on a Rex server, and return its exit status and output."""
    rex = ["rex", "--autostart=false", "--timeout", "10s", "-S", server]
    # Keep the session after the command exits so its output can be read, then kill it.
    created = json.loads(output([*rex, "new", "--json", "--keep-open", label, "--", *argv], timeout=20))
    session = created["session_id"]
    block = created["initial_windows"][0]["block_ids"][0]
    try:
        status = run([*rex, "wait", "-s", session, block, "--for", f"{wait}s"],
                     capture=True, check=False, timeout=wait + 10)
        text = output([*rex, "capture", "-s", session, "-b", block, "--trim", "--unwrap"], timeout=20)
    finally:
        run([*rex, "kill", session], capture=True, check=False, timeout=20)
    return status.returncode, text


def remote_records(host):
    """Run rox ls on a Rex host in a short-lived session and read its records."""
    returncode, text = rex_output(host, "rox ls", LIST_COMMAND)
    if returncode == 127 or "rox: not found" in text or "rox: command not found" in text:
        raise Error("rox isn't installed there")
    if returncode:
        raise Error(f"rox ls exited with status {returncode}: {text.strip()[-200:]}")
    if text.lstrip().startswith("#rox-plain"):
        # An older rox without --json prints one guest per line.
        rows = [line.split(None, 4) for line in text.splitlines()[1:] if re.match(NAME_PATTERN, line)]
        return [dict(zip(("name", "backend", "phase", "ip", "projects"), row + ["-"] * (5 - len(row))))
                for row in rows]
    records = json.loads(text[text.index("["):text.rindex("]") + 1])
    if not isinstance(records, list):
        raise Error("rox ls returned something other than a list")
    return records


def list_guests(scope=None, as_json=False):
    """List workspaces here, on one Rex host, or on every reachable Rex host."""
    if scope is None:
        records = local_records()
        if as_json:
            print(json.dumps(records, indent=2))
        else:
            for record in records:
                print(record_row(record))
        return

    unique, problems = gather_records(scope)
    if scope != "all" and problems:
        raise Error(f"Could not list workspaces on {scope}: {problems[scope]}")
    if as_json:
        print(json.dumps([{**record, "host": host} for host, records in unique.items() for record in records],
                         indent=2))
    else:
        print("HOST\tNAME\tBACKEND\tPHASE\tIP\tPROJECTS")
        for host, records in unique.items():
            for record in records:
                print(f"{host}\t{record_row(record)}")
    for host, problem in problems.items():
        print(f"rox: Skipped {host}: {problem}", file=sys.stderr)


def gather_records(scope):
    """Return each host's workspace records, and why any host couldn't be asked.

    scope is "all" for this machine and every Rex host, or one host label. This machine's
    records are under "this machine".
    """
    hosts = rex_host_labels() if scope == "all" else [scope]
    here = server_id()
    results = {"this machine": local_records()} if scope == "all" else {}
    problems = {}

    def ask(host):
        if scope == "all" and server_id(host) == here:
            return host, None, None  # Another label for this machine's own server.
        return host, remote_records(host), None

    def safely(host):
        try:
            return ask(host)
        except (Error, ValueError, KeyError, subprocess.SubprocessError) as error:
            return host, None, str(error) or type(error).__name__

    with ThreadPoolExecutor(max_workers=8) as pool:
        for host, records, problem in pool.map(safely, hosts):
            if problem:
                problems[host] = problem
            elif records is not None:
                results[host] = records
    # Two labels can name the same server, so keep each launcher's guests once.
    unique, names = {}, set()
    for host, records in results.items():
        fresh = [record for record in records if record.get("name") not in names]
        names.update(record.get("name") for record in fresh)
        unique[host] = fresh
    return unique, problems


def is_local(name):
    """Whether this machine runs the guest, as opposed to one of its Rex hosts."""
    try:
        Guest.load(name)
    except NotFound:
        return False
    return True


def find_remote_guest(name, host=None):
    """Find the Rex host that runs a guest this machine has no record of, and its record there."""
    unique, problems = gather_records(host or "all")
    for label, records in unique.items():
        for record in records:
            if record.get("name") == name and label != "this machine":
                return label, record
    if host and problems:
        raise Error(f"Could not list workspaces on {host}: {problems[host]}")
    skipped = f" Couldn't ask {', '.join(sorted(problems))}." if problems else ""
    where = f"on {host}" if host else "here or on any Rex host"
    raise Error(f"No managed workspace named {name} {where}.{skipped}")


def run_on_host(host, label, argv, wait=600):
    """Run a rox command on another host, print what it printed, and fail when it failed."""
    returncode, text = rex_output(host, label, [*REMOTE_ROX, *argv], wait=wait)
    if text.strip():
        print(text.rstrip(), flush=True)
    if returncode:
        raise Error(f"rox {argv[0]} exited with status {returncode} on {host}")


def remote_ssh_key():
    """This machine's key for SSH into guests on other hosts, created on first use."""
    directory = private_directory(state_root() / "remote")
    key = directory / "login"
    if not key.exists():
        require(["ssh-keygen"])
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "rox remote shell", "-f", str(key)],
            stdin=subprocess.DEVNULL)
    return key


# Authorize a key for the guest user. The container entrypoint rewrites authorized_keys on each
# start, so this runs before every remote shell.
AUTHORIZE_SCRIPT = r"""set -eu
umask 077
mkdir -p "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
grep -qxF "$1" "$HOME/.ssh/authorized_keys" || printf '%s\n' "$1" >> "$HOME/.ssh/authorized_keys"
"""


def free_port():
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


@contextmanager
def tailnet_forward(server, forwards):
    """Forward local ports through a guest's tailnet Rex server for as long as the block runs."""
    argv = ["rex", "--autostart=false", "-S", server, "forward", "new"]
    for local, port in forwards:
        argv += ["-L", f"127.0.0.1:{local}:127.0.0.1:{port}"]
    process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                               text=True)

    def listening():
        if process.poll() is not None:
            raise Error(f"rex forward exited: {process.stderr.read().strip() or process.returncode}")
        with socket.socket() as probe:
            probe.settimeout(1)
            return probe.connect_ex(("127.0.0.1", forwards[0][0])) == 0

    try:
        wait_for(listening, 20, f"the tunnel through {server}")
        yield
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


def remote_shell(host, record, key=None):
    """Open a shell in this terminal in a guest on another host, through the guest's tailnet Rex server."""
    name, server = record["name"], record["tailnet"]
    if not record.get("socket") or not record.get("user"):
        raise Error(f"Upgrade rox on {host} to open shells in its guests from here")
    require(["ssh", "ssh-keyscan", "rex"])
    checkouts = [(entry["id"], entry["name"], entry["workspace"]) for entry in record.get("checkouts", [])]
    directory = shell_directory(name, checkouts, record["home"], key)
    sessions = record.get("sessions", {})
    session = next((sessions.get(entry["id"], "") for entry in record.get("checkouts", [])
                    if entry["workspace"] == directory), sessions.get("", ""))
    login = remote_ssh_key()
    public_key = Path(f"{login}.pub").read_text().strip()
    returncode, text = rex_output(server, f"rox shell {name}", ["sh", "-c", AUTHORIZE_SCRIPT, "rox", public_key])
    if returncode:
        raise Error(f"Could not authorize this machine's SSH key in {name}: {text.strip()[-200:]}")
    known_hosts = private_directory(state_root() / "remote") / f"{name}.known_hosts"
    port = free_port()
    argv = [
        "ssh", "-F", "/dev/null", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "IdentitiesOnly=yes",
        "-o", "StrictHostKeyChecking=yes", "-o", "GlobalKnownHostsFile=/dev/null", "-o", f"HostKeyAlias={name}",
        "-o", f"UserKnownHostsFile={known_hosts}", "-o", "ForwardAgent=no",
        "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
        "-i", str(login), "-l", record["user"], "-p", str(port), "-t", "--", "127.0.0.1",
        shlex.join(shell_command(record["socket"], directory, session)),
    ]
    with tailnet_forward(server, [(port, 22)]):
        # The tunnel ends inside the guest, behind the Rex server's authenticated tailnet
        # connection, so the key it reports is the guest's own.
        scanned = output(["ssh-keyscan", "-q", "-t", "ed25519", "-p", str(port), "127.0.0.1"], timeout=20)
        fields = next((line.split()[1:3] for line in scanned.splitlines() if len(line.split()) >= 3), None)
        if not fields:
            raise Error(f"{name} didn't report an SSH host key")
        known_hosts.write_text(f"{name} {fields[0]} {fields[1]}\n")
        status = subprocess.run(argv, env={**os.environ, "TERM": "xterm-256color"}).returncode
    if status:
        sys.exit(status)


def app_shell(host, name, key=None):
    """Open rox shell on the guest's own host in a Rex session there, and show it in the Rex app."""
    created = json.loads(output(["rex", "--autostart=false", "-S", host, "new", "--json", f"rox shell {name}",
                                 "--", *REMOTE_ROX, "shell", name, *([key] if key else [])], timeout=20))
    session = created["session_id"]
    print(f"{name} isn't on the tailnet, so its shell opened on {host} in Rex session {session}.", flush=True)
    client = local_app_client()
    shown = client and run(["rex", "--autostart=false", "-C", client, "do", "session.select",
                            f"session_id={session}"], capture=True, check=False, timeout=15).returncode == 0
    if shown:
        print("It's showing in the Rex app.", flush=True)
    else:
        print(f"Open it from {host} in the Rex app, or run: rex -S {host} session inspect {session}", flush=True)


def remote_forward(host, record, ports):
    name, server = record["name"], record.get("tailnet")
    if not server:
        raise Error(f"{name} runs on {host} and isn't on the tailnet, so forward its ports from {host}. "
                    f"Configure tailscale there with rox config tailscale to forward from here")
    for local, port in ports:
        print(f"Forwarding http://localhost:{local} to port {port} on {name}, through the tailnet", flush=True)
    print("Press Ctrl-C to stop.", flush=True)
    argv = ["rex", "--autostart=false", "-S", server, "forward", "new"]
    for local, port in ports:
        argv += ["-L", f"127.0.0.1:{local}:127.0.0.1:{port}"]
    os.execvp(argv[0], argv)


def route_remote(args):
    """Run a command that names a guest on the host that runs it, when that isn't this machine.

    Return True when the command was handled elsewhere.
    """
    name = getattr(args, "name", None)
    host = getattr(args, "host", None)
    if not name or (host is None and is_local(name)):
        return False
    if args.command in ("down", "add") and host is not None:
        return False  # These already run on the named host.
    host, record = find_remote_guest(name, host)
    if args.command == "shell":
        if record.get("tailnet"):
            remote_shell(host, record, args.project)
        else:
            app_shell(host, name, args.project)
    elif args.command == "forward":
        remote_forward(host, record, args.ports)
    elif args.command == "funnel":
        run_on_host(host, f"rox funnel {name}", [
            "funnel", name, *([str(args.port)] if args.port else []), f"--https={args.https}",
            f"--path={args.path}", *(["--off"] if args.off else [])])
    elif args.command in ("down", "add"):
        args.host = host
        return False
    else:
        extra = ["--no-app-host"] if args.command == "reconnect" else []
        if args.command == "update-agents" and args.config:
            extra = [f"--config={args.config}"]
        run_on_host(host, f"rox {args.command} {name}", [args.command, name, *extra])
    return True


SERVICE_LABEL = "io.rox.service"
SERVICE_INTERVAL = 15


def service_log(message):
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}", flush=True)


def service_tick(retry, now):
    """Restore each ready guest that should run but stopped or lost its tunnel.

    retry maps a guest name to (next attempt, delay), so a guest that keeps failing is tried
    less often, up to every ten minutes.
    """
    for path in sorted(state_root().glob("*/guest.json")):
        name = path.parent.name
        try:
            guest = Guest.load(name)
        except (Error, OSError, ValueError, KeyError, TypeError):
            continue
        if guest.phase != "ready" or guest.stopped or not guest.guest_socket:
            retry.pop(name, None)
            continue
        if now < retry.get(name, (0, 0))[0]:
            continue
        try:
            with guest_lock(guest.directory):
                guest = Guest.load(name)
                if guest.phase == "ready" and not guest.stopped and resume(guest, saved_tailnet(guest)):
                    service_log(f"Restored {name}")
            retry.pop(name, None)
        except Busy:
            continue
        except (Error, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            delay = min(max(retry.get(name, (0, 0))[1] * 2, 30), 600)
            retry[name] = (now + delay, delay)
            service_log(f"Could not restore {name}, trying again in {delay}s: {error}")


def service_run(interval):
    """Keep guests running until rox is upgraded, then exit so the service manager restarts it."""
    script = HERE / "rox"
    installed = script.stat().st_mtime
    retry = {}
    service_log(f"Watching rox guests every {interval}s")
    while True:
        try:
            if script.stat().st_mtime != installed:
                service_log("rox changed on disk, so restarting to load it")
                return
        except FileNotFoundError:
            pass  # An upgrade is replacing the install. Check again next time.
        service_tick(retry, time.monotonic())
        time.sleep(interval)


def service_file():
    if sys.platform == "darwin":
        return Path.home() / "Library" / "LaunchAgents" / f"{SERVICE_LABEL}.plist"
    return xdg("XDG_CONFIG_HOME", ".config") / "systemd" / "user" / "rox.service"


def service_environment():
    """The PATH and rox locations to run the service with, since service managers start with neither."""
    home = Path.home()
    extra = [str(home / ".local" / "bin"), "/opt/homebrew/bin", "/usr/local/bin"]
    entries = [*os.environ.get("PATH", "").split(os.pathsep), *extra, "/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    environment = {"PATH": os.pathsep.join(dict.fromkeys(entry for entry in entries if entry))}
    for variable in ("XDG_STATE_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME"):
        if os.environ.get(variable):
            environment[variable] = os.environ[variable]
    return environment


def systemd_quote(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def install_service():
    path = service_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    private_directory(state_root())
    log = state_root() / "service.log"
    command = [str(HERE / "rox"), "service", "run"]
    environment = service_environment()
    if sys.platform == "darwin":
        require(["launchctl"])
        path.write_bytes(plistlib.dumps({
            "Label": SERVICE_LABEL,
            "ProgramArguments": command,
            "EnvironmentVariables": environment,
            "RunAtLoad": True,
            "KeepAlive": True,
            # Guests, tunnels and relays outlive the service, so restarting it mustn't stop them.
            "AbandonProcessGroup": True,
            "StandardOutPath": str(log),
            "StandardErrorPath": str(log),
        }))
        domain = f"gui/{os.getuid()}"
        run(["launchctl", "bootout", f"{domain}/{SERVICE_LABEL}"], capture=True, check=False)
        # launchd can take a moment to unload the previous copy.
        wait_for(lambda: run(["launchctl", "bootstrap", domain, str(path)], capture=True, check=False).returncode == 0,
                 10, "launchd to load the rox service")
        print(f"Installed the rox service at {path}. It starts at login and keeps guests running.")
    else:
        require(["systemctl"])
        lines = ["[Unit]", "Description=Keep rox guests running", "", "[Service]",
                 "ExecStart=" + " ".join(systemd_quote(part) for part in command),
                 *(f"Environment={systemd_quote(f'{key}={value}')}" for key, value in environment.items()),
                 "Restart=always", "RestartSec=10",
                 # Guests, tunnels and relays outlive the service, so restarting it mustn't stop them.
                 "KillMode=process", f"StandardOutput=append:{log}", f"StandardError=append:{log}",
                 "", "[Install]", "WantedBy=default.target", ""]
        path.write_text("\n".join(lines))
        output(["systemctl", "--user", "daemon-reload"])
        output(["systemctl", "--user", "enable", "rox.service"])
        output(["systemctl", "--user", "restart", "rox.service"])
        print(f"Installed the rox service at {path}. It starts at login and keeps guests running.")
        print("To keep it running while you're logged out, run: loginctl enable-linger $USER")
    print(f"Log: {log}")


def uninstall_service():
    path = service_file()
    if sys.platform == "darwin":
        run(["launchctl", "bootout", f"gui/{os.getuid()}/{SERVICE_LABEL}"], capture=True, check=False)
        path.unlink(missing_ok=True)
    else:
        run(["systemctl", "--user", "disable", "--now", "rox.service"], capture=True, check=False)
        path.unlink(missing_ok=True)
        run(["systemctl", "--user", "daemon-reload"], capture=True, check=False)
    print("Removed the rox service. Guests keep running, but nothing restarts them.")


def service_status():
    path = service_file()
    if not path.exists():
        print("The rox service isn't installed. Install it with rox service install")
        return
    if sys.platform == "darwin":
        result = run(["launchctl", "print", f"gui/{os.getuid()}/{SERVICE_LABEL}"], capture=True, check=False)
        match = re.search(r"^\s*state = (\S+)", result.stdout, re.MULTILINE)
        state = match[1] if match else "not loaded"
    else:
        state = run(["systemctl", "--user", "is-active", "rox.service"], capture=True, check=False).stdout.strip()
    print(f"Service  {state}\nFile     {path}\nLog      {state_root() / 'service.log'}")


SKILL_AGENTS = {
    "claude": ("CLAUDE_CONFIG_DIR", ".claude"),
    "codex": ("CODEX_HOME", ".codex"),
}


def agent_home(agent):
    variable, fallback = SKILL_AGENTS[agent]
    return Path(os.environ.get(variable) or Path.home() / fallback).expanduser()


def is_rox_skill(path):
    try:
        header = (path / "SKILL.md").read_text().split("---", 2)[1]
    except (OSError, IndexError):
        return False
    return re.search(r"^name:\s*rox\s*$", header, re.MULTILINE) is not None


def install_skill(agents, directory, force):
    """Copy the skill bundled with this rox into each agent's skills folder."""
    source = HERE / "skills" / "rox"
    if not (source / "SKILL.md").is_file():
        raise Error(f"No bundled skill found at {source}")
    if directory:
        targets = [("", Path(directory).expanduser().resolve())]
    else:
        # Without --agent, install for each agent that's set up on this machine.
        agents = agents or [agent for agent in SKILL_AGENTS if agent_home(agent).is_dir()]
        if not agents:
            raise Error("Found no Claude Code or Codex folder. Choose one with --agent claude, "
                        "--agent codex, or --dir DIR")
        targets = [(agent, agent_home(agent) / "skills") for agent in agents]
    version_file = HERE / "VERSION"
    version = version_file.read_text().strip() if version_file.is_file() else "development"
    for agent, skills in targets:
        destination = skills / "rox"
        if destination.is_symlink() or (destination.exists() and not is_rox_skill(destination)):
            if not force:
                raise Error(f"{destination} exists and isn't a rox skill. Pass --force to replace it")
        skills.mkdir(parents=True, exist_ok=True)
        # Copy beside the destination, then swap it in so a failed copy leaves the old skill.
        staging = Path(tempfile.mkdtemp(prefix=".rox-skill-", dir=skills))
        try:
            shutil.copytree(source, staging / "rox")
            if destination.is_symlink() or destination.is_file():
                destination.unlink()
            elif destination.exists():
                shutil.rmtree(destination)
            (staging / "rox").rename(destination)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        label = {"claude": "Claude Code", "codex": "Codex"}.get(agent, "")
        print(f"Installed the rox skill ({version}){f' for {label}' if label else ''} at {destination}")
    print("Start a new agent session to load it. Run rox skill install again after upgrading rox.")


