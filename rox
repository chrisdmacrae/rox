                  open_parser, agents_parser):
        named.add_argument("-S", "--host", help=HOST_HELP)
    stop = commands.add_parser("down", help="delete a guest and its workspace")
    stop.add_argument("name", nargs="?",
                      help="workspace to remove; omit to pick from the current project's workspaces")
    stop.add_argument("--cwd", type=Path, default=Path.cwd(), help="directory within the project")
    stop.add_argument("-S", "--host", help="remove a guest that runs on this Rex remote host")
