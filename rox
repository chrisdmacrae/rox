PROJECT_CONTAINERFILE = """\
FROM {base}
USER root
RUN install -d -m 700 -o workspace -g workspace /home/workspace/.rox /home/workspace/.rox/image
COPY bootstrap.sh /usr/local/share/rox/bootstrap.sh
