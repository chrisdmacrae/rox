    template.add_argument("--config", help="config file on the machine that runs the guests")
    template.add_argument("--name", help=f"template name; defaults to macos.image or {DEFAULT_TEMPLATE_NAME}")
    template.add_argument("--base", default=DEFAULT_TEMPLATE_BASE, help="Tart image to clone the template from")
    template.add_argument("--base-password", default=DEFAULT_BASE_PASSWORD,
                          help="the base image's login password, which rox replaces")
    template.add_argument("--boot-timeout", type=positive_int, default=600, help="seconds per readiness check")
    config_parser = commands.add_parser("config", help="open the rox config in VISUAL or EDITOR")
    config_parser.add_argument("--config", help="alternate Rox configuration file")
    config_commands = config_parser.add_subparsers(dest="config_command")
    tailnet_parser = config_commands.add_parser(
        "tailscale", help="save a Tailscale auth key and put new guests on the tailnet")
    tailnet_parser.add_argument("--config", default=argparse.SUPPRESS, help="alternate Rox configuration file")
    tailnet_parser.add_argument("--tag", action="append",
                                help="tag for guest devices (repeatable); defaults to tag:rox-guest")
    tailnet_parser.add_argument("--control-url", help="https:// URL of a self-hosted control server such as Headscale")
    agent_config = config_commands.add_parser(
        "agents", help="install Claude Code or Codex in new guests, signed in with your credentials")
    agent_config.add_argument("agent", nargs="?", choices=sorted(AGENT_CREDENTIALS),
                              help="agent to set up; omit to choose interactively")
    agent_config.add_argument("--config", default=argparse.SUPPRESS, help="alternate Rox configuration file")
    agent_config.add_argument("--version", help="pin a version such as 1.2.3, or latest (the default)")
    agent_config.add_argument("--api-key", action="store_true", help="codex: sign in with an OpenAI API key")
    agent_config.add_argument("--auth-file", help="codex: login file to copy into guests (default ~/.codex/auth.json)")
    agent_config.add_argument("--off", action="store_true", help="stop installing the agent in new guests")
    agent_config.add_argument("--sync", metavar="ITEMS",
                              help="what to copy from this machine: a comma list of skills, instructions, mcp "
                                   "and settings, or none (default skills,instructions)")
    agent_config.add_argument("--mcp", action="append", metavar="NAME",
                              help="copy this remote MCP server into guests. Repeat for more")
    skill = commands.add_parser("skill", help="install the rox agent skill")
    skill_commands = skill.add_subparsers(dest="skill_command", required=True)
    install = skill_commands.add_parser("install", help="copy the bundled skill into Claude Code or Codex")
    install.add_argument("--agent", action="append", choices=sorted(SKILL_AGENTS),
                         help="agent to install for (repeatable); defaults to each one set up on this machine")
    install.add_argument("--dir", help="skills folder to install into instead, such as a project's .claude/skills")
    install.add_argument("--force", action="store_true", help="replace a folder named rox that isn't a rox skill")
    command = []
    if argv[:1] not in (["key"], ["skill"]) and "--" in argv:
        index = argv.index("--")
        argv, command = argv[:index], argv[index + 1:]
        if not command:
            parser.error("-- requires a command")
    args = parser.parse_args(argv)
    if args.command == "up":
        up(args, command)
    elif args.command == "add":
        if args.host is None and re.fullmatch(NAME_PATTERN, args.name) and not is_local(args.name):
            args.host = find_remote_guest(args.name)[0]
        add(args, command)
    elif command:
        parser.error("only up and add accept a command after --")
    elif args.command in ("shell", "forward", "funnel", "reconnect", "start", "stop", "down",
                          "update-agents") and route_remote(args):
        return
    elif args.command == "ls":
        list_guests("all" if args.all else args.host, args.json)
    elif args.command == "shell":
        shell(args.name, args.project)
    elif args.command == "forward":
        forward(args.name, args.ports)
    elif args.command == "reconnect":
        reconnect(args.name)
    elif args.command == "start":
        reconnect(args.name, force=False)
    elif args.command == "funnel":
        funnel(args.name, args.port, args.https, args.path, args.off)
    elif args.command == "open":
        open_guest(args.name, args.project, args.host)
    elif args.command == "add-remote-host":
        add_remote_host(args.name, args.host)
    elif args.command == "stop":
        stop_workspace(args.name)
    elif args.command == "update-agents":
        if bool(args.name) == args.all:
            parser.error("name a guest or pass --all")
        if args.all and args.host:
            run_on_host(args.host, "rox update-agents --all",
                        ["update-agents", "--all", *([f"--config={args.config}"] if args.config else [])])
        elif args.all:
            update_all_agents(args.config)
        else:
            update_agents(args.name, args.config)
    elif args.command == "key":
        edit_git_keys(args)
    elif args.command == "template" and args.host:
        options = [f"--{option.replace('_', '-')}={value}" for option, value in
                   (("config", args.config), ("name", args.name), ("base", args.base),
                    ("base_password", args.base_password), ("boot_timeout", args.boot_timeout)) if value]
        # A first template pulls a large image, so give it hours rather than minutes.
        run_on_host(args.host, "rox template", ["template", args.backend, *options], wait=4 * 3600)
    elif args.command == "template":
        prepare_template(args)
    elif args.command == "service":
        {"install": install_service, "uninstall": uninstall_service, "status": service_status,
         "run": lambda: service_run(args.interval)}[args.service_command]()
    elif args.command == "config" and args.config_command == "tailscale":
        configure_tailscale(args)
    elif args.command == "config" and args.config_command == "agents":
        configure_agents(args)
    elif args.command == "config":
        edit_config(args.config)
    elif args.command == "skill":
        if args.agent and args.dir:
            parser.error("choose --agent or --dir, not both")
        install_skill(args.agent, args.dir, args.force)
    else:
        if args.host is None and not args.name:
            args.name, args.host = choose_project_guest(args.cwd)
        if args.host is not None:
            down_remote(args)
        else:
            down(args.name)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (Error, OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        message = str(error)
        if isinstance(error, subprocess.CalledProcessError):
            message = f"{error.cmd[0]} exited with status {error.returncode}"
        print(f"rox: {message}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
